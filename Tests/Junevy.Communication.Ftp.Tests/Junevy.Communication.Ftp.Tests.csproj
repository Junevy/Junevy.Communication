<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\Junevy.Communication.Tests.props" />

  <!-- P6-C1：SDK 适配包只面向 .NET 8，测试项目同样只有一个目标（Import 的默认值是 net8.0;net472）。 -->
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Junevy.Communication.Ftp\Junevy.Communication.Ftp.csproj" />
    <ProjectReference Include="..\Junevy.Communication.Testing\Junevy.Communication.Testing.csproj" />
    <ProjectReference Include="..\Junevy.Communication.Testing.Servers\Junevy.Communication.Testing.Servers.csproj" />
  </ItemGroup>

  <!-- 用 appsettings 真正用的那条绑定路径验证选项（P6-C9）。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <!-- 与共享的 SDK 测试服务器（Microsoft.Extensions.Hosting 10.0.12）保持同一版本，避免 NU1605（计划 Task 16，同 P62-D1）。 -->
    <PackageReference Update="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <!-- P6-C12：FTP 的测试替身是自写的进程内模拟服务器（TestSupport/），不引用任何第三方 FTP 服务器包。 -->

  <!-- FTP 的模拟服务器（FakeFtpServer 等）来自共享项目（计划 Task 16）。 -->
  <ItemGroup>
    <Using Include="Junevy.Communication.Testing.Servers" />
  </ItemGroup>

</Project>
