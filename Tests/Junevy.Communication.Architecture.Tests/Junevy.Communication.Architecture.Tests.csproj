<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\Junevy.Communication.Tests.props" />

  <!-- 架构守卫：读取各生产程序集的元数据（引用与 InternalsVisibleTo），因此引用全部生产程序集。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\Junevy.Communication.Core\Junevy.Communication.Core.csproj" />
    <ProjectReference Include="..\..\Junevy.Communication.Channels\Junevy.Communication.Channels.csproj" />
    <ProjectReference Include="..\..\Junevy.Communication.Tcp\Junevy.Communication.Tcp.csproj" />
    <ProjectReference Include="..\..\Junevy.Communication.Udp\Junevy.Communication.Udp.csproj" />
    <ProjectReference Include="..\..\Junevy.Communication.Serial\Junevy.Communication.Serial.csproj" />
    <ProjectReference Include="..\..\Junevy.Communication.Plc\Junevy.Communication.Plc.csproj" />
    <ProjectReference Include="..\..\Junevy.Communication.Melsec\Junevy.Communication.Melsec.csproj" />
    <ProjectReference Include="..\..\Junevy.Communication.Siemens\Junevy.Communication.Siemens.csproj" />
    <ProjectReference Include="..\..\Junevy.Communication.Omron\Junevy.Communication.Omron.csproj" />
    <ProjectReference Include="..\..\Junevy.Communication.Secs\Junevy.Communication.Secs.csproj" />
    <ProjectReference Include="..\..\Junevy.Communication.WebApi\Junevy.Communication.WebApi.csproj" />
    <ProjectReference Include="..\..\Junevy.Communication.Modbus\Junevy.Communication.Modbus.csproj" />
  </ItemGroup>

  <!-- P6-C1：SDK 适配包只有 net8.0 目标，net472 下无法引用，因此项目引用与 SDK 守卫都只在 net8.0 上存在。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <ProjectReference Include="..\..\Junevy.Communication.Mqtt\Junevy.Communication.Mqtt.csproj" />
    <ProjectReference Include="..\..\Junevy.Communication.OpcUa\Junevy.Communication.OpcUa.csproj" />
    <ProjectReference Include="..\..\Junevy.Communication.Ftp\Junevy.Communication.Ftp.csproj" />
    <!-- P62-D1：OpcUa 的 SDK 把 Microsoft.Extensions.DependencyInjection 带到 10.0.12，这里跟着抬高，
         否则 Tests.props 的 8.0.0 会触发 NU1605 降级错误。只改本项目，不动共享的 Tests.props。 -->
    <PackageReference Update="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!-- P32-D2：服务端同样只面向 .NET 8（ASP.NET Core 8 共享框架），与 SDK 适配包一样只在 net8.0 上参与检查。 -->
    <ProjectReference Include="..\..\Junevy.Communication.WebApi.Server\Junevy.Communication.WebApi.Server.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Compile Remove="SdkAdapterArchitectureTests.cs" />
    <Compile Remove="SdkPublicApiWalker.cs" />
  </ItemGroup>

  <!-- 命名空间分层检查需要看到方法体中的类型引用，反射做不到；该包只出现在测试项目（P3-D18）。 -->
  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

</Project>
