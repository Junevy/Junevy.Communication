<Window
    x:Class="Junevy.Communication.Test.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Junevy.Communication.Test"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Modbus debug (v3)"
    Width="760"
    Height="420"
    d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
    mc:Ignorable="d">

    <Window.Resources>
        <local:BoolToColorConverter x:Key="BoolToColor" />
        <local:ReverseBoolConverter x:Key="ReverseBool" />
    </Window.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Connection">
            <StackPanel Margin="10">
                <TextBlock Text="Transport" />
                <ComboBox
                    IsEnabled="{Binding IsConnected, Converter={StaticResource ReverseBool}}"
                    ItemsSource="{Binding Transports}"
                    SelectedItem="{Binding Transport, Mode=TwoWay}" />

                <TextBlock Margin="0,8,0,0" Text="Host" />
                <TextBox
                    IsEnabled="{Binding IsConnected, Converter={StaticResource ReverseBool}}"
                    Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,8,0,0" Text="Port" />
                <TextBox
                    IsEnabled="{Binding IsConnected, Converter={StaticResource ReverseBool}}"
                    Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,8,0,0" Text="Serial port" />
                <ComboBox
                    IsEnabled="{Binding IsConnected, Converter={StaticResource ReverseBool}}"
                    ItemsSource="{Binding Serials}"
                    SelectedItem="{Binding PortName, Mode=TwoWay}" />

                <TextBlock Margin="0,8,0,0" Text="Baud rate" />
                <ComboBox
                    IsEnabled="{Binding IsConnected, Converter={StaticResource ReverseBool}}"
                    ItemsSource="{Binding BaudRates}"
                    SelectedItem="{Binding BaudRate, Mode=TwoWay}" />

                <TextBlock Margin="0,8,0,0" Text="Unit ID" />
                <TextBox Text="{Binding UnitId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <Button Command="{Binding ConnectCommand}" Content="Connect" Padding="12,2" />
                    <Button Margin="8,0,0,0" Command="{Binding DisconnectCommand}" Content="Disconnect" Padding="12,2" />
                </StackPanel>

                <TextBlock Margin="0,12,0,0" Text="{Binding Status}" TextWrapping="Wrap">
                    <TextBlock.Foreground>
                        <Binding Converter="{StaticResource BoolToColor}" Path="IsConnected" />
                    </TextBlock.Foreground>
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="Registers and coils">
            <StackPanel Margin="10">
                <TextBlock Text="Area" />
                <ComboBox ItemsSource="{Binding Areas}" SelectedItem="{Binding Area, Mode=TwoWay}" />

                <TextBlock Margin="0,8,0,0" Text="Start" />
                <TextBox Text="{Binding Start, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,8,0,0" Text="Count" />
                <TextBox Text="{Binding Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,8,0,0" Text="Value to write (HR: number, C: 1 or 0)" />
                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <Button Command="{Binding ReadCommand}" Content="Read" Padding="12,2" />
                    <Button Margin="8,0,0,0" Command="{Binding WriteCommand}" Content="Write" Padding="12,2" />
                </StackPanel>

                <DataGrid
                    Height="150"
                    Margin="0,10,0,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding DataList}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Address}" Header="Address" />
                        <DataGridTextColumn Binding="{Binding Value}" Header="Value" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
