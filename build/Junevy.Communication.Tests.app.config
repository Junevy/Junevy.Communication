<?xml version="1.0" encoding="utf-8"?>
<!-- net472 测试宿主的程序集绑定重定向。由 build/Junevy.Communication.Tests.props 通过 AppConfig 复制为各测试程序集的 .dll.config（仅 net472 目标）。
     NuGet 为 net472 解析到 System.Memory 4.5.5（程序集版本 4.0.1.2）；测试运行时会请求 4.0.5.0（与 System.Memory 4.6.3 的程序集版本一致），
     System.IO.Pipelines 等则请求 10.0.0.0。不重定向会抛出 FileLoadException。 -->
<configuration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="4.0.1.2" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
