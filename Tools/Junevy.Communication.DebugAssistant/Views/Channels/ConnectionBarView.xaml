<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Channels.ConnectionBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy">
    <!-- 连接栏：连接、取消、断开与状态；右侧的统计文字较长，可用宽度不够时换行，不截断。 -->
    <Border Style="{StaticResource Panel.Card}" Padding="12,8">
        <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <jv:Button Content="{Binding ConnectText}" Command="{Binding ConnectCommand}" Margin="0,0,8,0" />
                <jv:Button Content="取消" Command="{Binding ConnectCancelCommand}" Margin="0,0,8,0" />
                <jv:Button Content="{Binding DisconnectText}" Command="{Binding DisconnectCommand}" Margin="0,0,16,0" />
                <jv:TextBlock Text="{Binding StateText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <jv:TextBlock Text="{Binding StatisticsText}" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"
                          Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />
        </DockPanel>
    </Border>
</UserControl>
