<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Channels.TcpClientPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <jv:GroupBox Grid.Row="0" Header="连接参数" Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <WrapPanel>
                    <Label Content="主机" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,12,0" />
                    <Label Content="端口" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                    <Label Content="本地地址（留空为系统选择）" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding LocalAddress, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,12,0" />
                    <Label Content="本地端口（0 为系统选择）" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                </WrapPanel>
            </jv:GroupBox>

            <local:ConnectionBarView Grid.Row="1" Margin="0,0,0,6" />

            <jv:GroupBox Grid.Row="2" Header="通道参数" IsCollapsible="True" IsCollapsed="True" Margin="0,0,0,6"
                         IsEnabled="{Binding IsEditable}">
                <local:ChannelSettingsView DataContext="{Binding Settings}" MaxHeight="360" />
            </jv:GroupBox>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <local:SendPanelView Grid.Column="0" />
                <local:OperationListView Grid.Column="1" Margin="8,0,0,0" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
