<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Channels.TcpClientPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- 布局：顶部连接栏；左侧参数与发送（可滚动）；中间收到的帧；右侧操作记录；底部报文与日志（可折叠）。 -->
    <DockPanel Margin="12">
        <jv:ExpanderPanel DockPanel.Dock="Bottom" DisplayMode="Card" Header="报文与日志" IsExpanded="False" Margin="0,12,0,0">
            <sessions:LogPanel DataContext="{Binding LogPanel}" Height="200" />
        </jv:ExpanderPanel>

        <local:ConnectionBarView DockPanel.Dock="Top" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <jv:GroupBox Header="连接参数" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <WrapPanel>
                                <jv:TextBox Width="200" atc:TitleAssist.Title="主机"
                                            Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="端口"
                                            Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="200" atc:TitleAssist.Title="本地地址"
                                            Text="{Binding LocalAddress, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="本地端口"
                                            Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <jv:TextBlock Style="{StaticResource Text.Hint}" Text="本地地址留空、本地端口为 0 时由系统选择。" />
                        </StackPanel>
                    </jv:GroupBox>

                    <local:SendPanelView />

                    <jv:GroupBox Header="通道参数" IsCollapsible="True" IsCollapsed="True" IsEnabled="{Binding IsEditable}">
                        <local:ChannelSettingsView DataContext="{Binding Settings}" />
                    </jv:GroupBox>
                </StackPanel>
            </ScrollViewer>

            <local:ReceivedFramesView Grid.Column="2" />
            <local:OperationListView Grid.Column="4" />
        </Grid>
    </DockPanel>
</UserControl>
