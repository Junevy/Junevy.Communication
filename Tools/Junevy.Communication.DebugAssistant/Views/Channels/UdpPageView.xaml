<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Channels.UdpPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <jv:GroupBox Grid.Row="0" Header="本地与模式" Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <StackPanel>
                    <WrapPanel>
                        <Label Content="本地地址" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding LocalAddress, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,12,0" />
                        <Label Content="本地端口（0 为系统选择）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <CheckBox Content="定向（固定远端）" IsChecked="{Binding Directed}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <CheckBox Content="允许广播" IsChecked="{Binding EnableBroadcast}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <CheckBox Content="地址复用" IsChecked="{Binding ReuseAddress}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="远端（定向）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding RemoteHost, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,6,0" />
                        <TextBox Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                        <Label Content="目标（非定向）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding TargetHost, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,6,0" />
                        <TextBox Text="{Binding TargetPort, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="组播组（逗号分隔）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MulticastGroups, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,12,0" />
                        <Label Content="TTL" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MulticastTimeToLive, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0" />
                        <CheckBox Content="组播回环" IsChecked="{Binding MulticastLoopback}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Label Content="请求重试次数" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding RequestRetryCount, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0" />
                        <Label Content="数据报上限（字节）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MaxDatagramSize, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </WrapPanel>
                </StackPanel>
            </jv:GroupBox>

            <local:ConnectionBarView Grid.Row="1" Margin="0,0,0,6" />

            <jv:GroupBox Grid.Row="2" Header="通道参数" IsCollapsible="True" IsCollapsed="True" Margin="0,0,0,6"
                         IsEnabled="{Binding IsEditable}">
                <local:ChannelSettingsView DataContext="{Binding Settings}" MaxHeight="360" />
            </jv:GroupBox>

            <TextBlock Grid.Row="3" Margin="0,0,0,4" Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                       Text="数据报没有分帧：一个数据报就是一帧。非定向模式下，发送与请求的目标使用上面的“目标”地址；非定向没有固定的对端，因此不能使用内置心跳（连接时会被拒绝）。" />

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <local:SendPanelView Grid.Column="0" />
                <local:OperationListView Grid.Column="1" Margin="8,0,0,0" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
