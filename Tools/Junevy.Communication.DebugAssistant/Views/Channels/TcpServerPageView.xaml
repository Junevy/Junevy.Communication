<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Channels.TcpServerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <jv:GroupBox Grid.Row="0" Header="监听" Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <WrapPanel>
                    <Label Content="监听地址" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Settings.ListenAddress, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,12,0" />
                    <Label Content="端口" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Settings.Port, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                    <Label Content="等待队列" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Settings.Backlog, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                    <Label Content="最大会话数（0 为不限）" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Settings.MaxSessions, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                    <Label Content="允许的远端地址（逗号分隔，留空为不限）" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Settings.AllowedRemoteAddresses, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,12,0" />
                    <Label Content="停止超时（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Settings.StopTimeout, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                </WrapPanel>
            </jv:GroupBox>

            <local:ConnectionBarView Grid.Row="1" Margin="0,0,0,6" />

            <jv:GroupBox Grid.Row="2" Header="会话参数（分帧、心跳、超时、套接字、握手、TLS）" IsCollapsible="True" IsCollapsed="True"
                         Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <local:TcpServerSettingsView DataContext="{Binding Settings}" MaxHeight="360" />
            </jv:GroupBox>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- 左：会话列表，以及向选中的会话发送、广播、关闭 -->
                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Top" Text="会话" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <TextBox Text="{Binding PayloadText, UpdateSourceTrigger=PropertyChanged}" Height="60" AcceptsReturn="True" />
                        <WrapPanel Margin="0,4,0,0">
                            <Label Content="编码" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Source={StaticResource EncodingChoices}}" SelectedItem="{Binding PayloadEncoding}" Width="110" Margin="0,0,12,0" />
                            <Label Content="校验" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Source={StaticResource ChecksumKinds}}" SelectedItem="{Binding Checksum}" Width="150" />
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <jv:Button Content="发送给选中会话" Command="{Binding SendToSelectedCommand}" Margin="0,0,8,0" />
                            <jv:Button Content="广播" Command="{Binding BroadcastCommand}" Margin="0,0,8,0" />
                            <jv:Button Content="关闭选中会话" Command="{Binding CloseSelectedCommand}" />
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" IsReadOnly="True"
                              AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="远端" Binding="{Binding Remote}" Width="150" />
                            <DataGridTextColumn Header="连接时间" Binding="{Binding ConnectedAt, StringFormat=HH:mm:ss}" Width="80" />
                            <DataGridCheckBoxColumn Header="TLS" Binding="{Binding IsTls}" Width="50" />
                            <DataGridTextColumn Header="统计" Binding="{Binding Statistics}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- 中：自动应答规则，以及收到的帧 -->
                <Grid Grid.Column="1" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="自动应答规则（按顺序，第一条匹配的生效）" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                        <TextBox Text="{Binding AutoReplyMatch, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,6,0" ToolTip="匹配的前缀，留空匹配所有帧" />
                        <TextBox Text="{Binding AutoReplyReply, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,6,0" ToolTip="回复的内容（回显时不使用）" />
                        <CheckBox Content="回显" IsChecked="{Binding AutoReplyEcho}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <jv:Button Content="添加规则" Command="{Binding AddAutoReplyCommand}" />
                    </WrapPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding AutoReplies}" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" MaxHeight="150">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="匹配" Binding="{Binding Match}" Width="*" />
                            <DataGridTextColumn Header="回复" Binding="{Binding Reply}" Width="*" />
                            <DataGridCheckBoxColumn Header="回显" Binding="{Binding Echo}" Width="50" />
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <jv:Button Content="删除"
                                                   Command="{Binding DataContext.RemoveAutoReplyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Text="收到的帧" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <DataGrid Grid.Row="4" ItemsSource="{Binding ReceivedFrames}" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss.fff}" Width="90" />
                            <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="150" />
                            <DataGridTextColumn Header="HEX" Binding="{Binding Hex}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <local:OperationListView Grid.Column="2" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
