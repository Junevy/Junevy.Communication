<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Channels.TcpServerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- 布局：顶部连接栏；左侧监听、自动应答、发送与会话参数（可滚动，可拖宽）；右侧上方会话与收到的帧，下方为操作记录与报文日志（可拖高）。 -->
    <DockPanel Margin="12">
        <local:ConnectionBarView DockPanel.Dock="Top" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Style="{StaticResource Panel.SettingsScroll}">
                <StackPanel>
                    <jv:GroupBox Header="监听" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <WrapPanel>
                                <jv:TextBox Width="200" atc:TitleAssist.Title="监听地址"
                                            Text="{Binding Settings.ListenAddress, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="端口"
                                            Text="{Binding Settings.Port, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="等待队列"
                                            Text="{Binding Settings.Backlog, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="140" atc:TitleAssist.Title="最大会话数"
                                            Text="{Binding Settings.MaxSessions, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="280" atc:TitleAssist.Title="允许的远端地址" atc:PlaceholderAssist.Placeholder="逗号分隔，留空为不限"
                                            Text="{Binding Settings.AllowedRemoteAddresses, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="130" atc:TitleAssist.Title="停止超时（毫秒）"
                                            Text="{Binding Settings.StopTimeout, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <jv:TextBlock Style="{StaticResource Text.Hint}" Text="最大会话数为 0 时不限。" />
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="自动应答规则" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <jv:TextBlock Style="{StaticResource Text.Hint}"
                                          Text="按顺序检查，第一条匹配的生效；匹配前缀留空时匹配所有帧。回显时不使用“回复”。" />
                            <WrapPanel>
                                <jv:TextBox Width="120" atc:TitleAssist.Title="匹配（前缀）"
                                            Text="{Binding AutoReplyMatch, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="120" atc:TitleAssist.Title="回复"
                                            Text="{Binding AutoReplyReply, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:CheckBox Content="回显" IsChecked="{Binding AutoReplyEcho}" />
                                <jv:Button Content="添加规则" Command="{Binding AddAutoReplyCommand}" Margin="0,22,0,12" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding AutoReplies}" IsReadOnly="True" AutoGenerateColumns="False"
                                      CanUserAddRows="False" MaxHeight="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="匹配" Binding="{Binding Match}" Width="*" />
                                    <DataGridTextColumn Header="回复" Binding="{Binding Reply}" Width="*" />
                                    <DataGridCheckBoxColumn Header="回显" Binding="{Binding Echo}" Width="50" />
                                    <DataGridTemplateColumn Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <jv:Button Content="删除"
                                                           Command="{Binding DataContext.RemoveAutoReplyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </jv:GroupBox>

                    <!-- 发送给会话：发送内容与目标（选中的会话或全部会话） -->
                    <Border Style="{StaticResource Panel.Card}">
                        <StackPanel>
                            <jv:TextBlock Style="{StaticResource Text.Section}" Text="发送给会话" />
                            <jv:TextBox Text="{Binding PayloadText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48"
                                        atc:TitleAssist.Title="发送内容（hex: 开头为十六进制）" Margin="0,0,0,12" />
                            <WrapPanel>
                                <jv:ComboBox Width="110" atc:TitleAssist.Title="编码"
                                             ItemsSource="{Binding Source={StaticResource EncodingChoices}}" SelectedItem="{Binding PayloadEncoding}" />
                                <jv:ComboBox Width="150" atc:TitleAssist.Title="校验"
                                             ItemsSource="{Binding Source={StaticResource ChecksumKinds}}" SelectedItem="{Binding Checksum}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:Button Content="发送给选中会话" Command="{Binding SendToSelectedCommand}" Margin="0,0,8,12" />
                                <jv:Button Content="广播" Command="{Binding BroadcastCommand}" Margin="0,0,8,12" />
                                <jv:Button Content="关闭选中会话" Command="{Binding CloseSelectedCommand}" Margin="0,0,8,12" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <jv:GroupBox Header="会话参数（分帧、心跳、超时、套接字、握手、TLS）" IsCollapsible="True" IsCollapsed="True"
                                 IsEnabled="{Binding IsEditable}">
                        <local:TcpServerSettingsView DataContext="{Binding Settings}" />
                    </jv:GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Columns}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="160" MinHeight="100" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="220" MinHeight="120" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <jv:TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Section}" Text="会话（选中后可单独发送或关闭）" />
                    <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" IsReadOnly="True"
                              AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="远端" Binding="{Binding Remote}" Width="150" />
                            <DataGridTextColumn Header="连接时间" Binding="{Binding ConnectedAt, StringFormat=HH:mm:ss}" Width="80" />
                            <DataGridCheckBoxColumn Header="TLS" Binding="{Binding IsTls}" Width="50" />
                            <DataGridTextColumn Header="统计" Binding="{Binding Statistics}" Width="*" MinWidth="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <GridSplitter Grid.Row="1" Style="{StaticResource Splitter.Rows}" />

                <local:ReceivedFramesView Grid.Row="2" />

                <GridSplitter Grid.Row="3" Style="{StaticResource Splitter.Rows}" />

                <TabControl Grid.Row="4">
                    <TabItem Header="操作记录">
                        <local:OperationListView Margin="8" />
                    </TabItem>
                    <TabItem Header="报文与日志">
                        <sessions:LogPanel DataContext="{Binding LogPanel}" Margin="8" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
