<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Channels.ChannelSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <!-- 分帧：只对 TCP 与串口显示；每种模式只显示自己的参数 -->
            <Border Visibility="{Binding ShowsFraming, Converter={StaticResource BoolToVisibility}}">
                <local:FramingSectionView DataContext="{Binding Framing}" />
            </Border>

            <!-- 关联 -->
            <jv:GroupBox Header="请求与应答的关联" Margin="0,0,0,8">
                <StackPanel DataContext="{Binding Correlation}">
                    <WrapPanel Margin="0,0,0,6">
                        <Label Content="方式" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource CorrelationModes}}" SelectedItem="{Binding Mode}" Width="160" />
                    </WrapPanel>
                    <WrapPanel>
                        <Label Content="匹配规则" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <CheckBox Content="应答以某段字节开头" IsChecked="{Binding MatchByPrefix}" Margin="0,0,12,0" />
                        <TextBox Text="{Binding ResponsePrefix, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="回显偏移" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding EchoOffset, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="回显长度" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding EchoLength, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </WrapPanel>
                    <TextBlock Text="键字段（请求）" Margin="0,8,0,2" />
                    <WrapPanel>
                        <TextBox Text="{Binding RequestKeyOffset, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,8,0" />
                        <TextBox Text="{Binding RequestKeyWidth, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource KeyOrders}}" SelectedItem="{Binding RequestKeyOrder}" Width="140" />
                    </WrapPanel>
                    <TextBlock Text="键字段（应答）" Margin="0,8,0,2" />
                    <WrapPanel>
                        <TextBox Text="{Binding ResponseKeyOffset, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,8,0" />
                        <TextBox Text="{Binding ResponseKeyWidth, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource KeyOrders}}" SelectedItem="{Binding ResponseKeyOrder}" Width="140" />
                    </WrapPanel>
                </StackPanel>
            </jv:GroupBox>

            <!-- 心跳与重连 -->
            <local:HeartbeatSectionView DataContext="{Binding Heartbeat}" />

            <jv:GroupBox Header="重连" IsCollapsible="True" IsCollapsed="True" Margin="0,0,0,8">
                <StackPanel DataContext="{Binding Reconnect}">
                    <CheckBox Content="断开后自动重连" IsChecked="{Binding Enabled}" />
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="方式" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource ReconnectModes}}" SelectedItem="{Binding Mode}" Width="180" Margin="0,0,12,0" />
                        <Label Content="间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,12,0" />
                        <Label Content="最大间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MaxInterval, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="最多次数（0 为不限）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MaxAttempts, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <CheckBox Content="首次连接失败也重连" IsChecked="{Binding OnInitialFailure}" VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
            </jv:GroupBox>

            <!-- 超时 -->
            <jv:GroupBox Header="超时（毫秒）" IsCollapsible="True" IsCollapsed="True" Margin="0,0,0,8">
                <StackPanel DataContext="{Binding Timeouts}">
                    <WrapPanel>
                        <Label Content="连接" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ConnectTimeout, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="握手" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding HandshakeTimeout, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="发送" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding SendTimeout, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="请求" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding RequestTimeout, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="空闲（0 为关闭）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding IdleTimeout, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="半帧（0 为关闭）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding PartialFrameTimeout, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="断开" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding DisconnectTimeout, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="迟到应答窗口（-1 为默认）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding LateReplyWindow, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </WrapPanel>
                    <CheckBox Content="请求超时后重建连接" IsChecked="{Binding ResetOnRequestTimeout}" Margin="0,4,0,0" />
                </StackPanel>
            </jv:GroupBox>

            <!-- 套接字与 TLS：只对 TCP 显示 -->
            <Border Visibility="{Binding ShowsSocketAndTls, Converter={StaticResource BoolToVisibility}}">
                <local:SocketSectionView DataContext="{Binding Socket}" />
            </Border>

            <jv:GroupBox Header="TLS（TCP）" IsCollapsible="True" IsCollapsed="True" Margin="0,0,0,8"
                         Visibility="{Binding ShowsSocketAndTls, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DataContext="{Binding Tls}">
                    <CheckBox Content="启用 TLS" IsChecked="{Binding Enabled}" />
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="目标主机名（证书校验）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding TargetHost, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                    </WrapPanel>
                    <CheckBox Content="检查证书吊销" IsChecked="{Binding CheckCertificateRevocation}" Margin="0,4,0,0" />
                    <CheckBox Content="允许不受信任的服务器证书（有风险）" IsChecked="{Binding AllowUntrustedServerCertificate}" Margin="0,4,0,0" />
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="客户端证书" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource ClientCertificateKinds}}" SelectedItem="{Binding ClientCertificate}" Width="120" Margin="0,0,12,0" />
                        <Label Content="指纹（Store）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Thumbprint, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="PFX 路径（Pfx）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding PfxPath, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,12,0" />
                        <Label Content="口令环境变量名" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding PfxPasswordVariable, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                    </WrapPanel>
                </StackPanel>
            </jv:GroupBox>

            <!-- 握手 -->
            <local:HandshakeSectionView DataContext="{Binding Handshake}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
