<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Channels.SendPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls">
    <!-- 发送内容、发送与请求，以及定时发送和发送历史（默认折叠）。DataContext 是页签。 -->
    <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,12">
        <StackPanel>
            <jv:TextBlock Style="{StaticResource Text.Section}" Text="发送" />
            <jv:TextBox Text="{Binding PayloadText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="64"
                        atc:TitleAssist.Title="发送内容（hex: 开头为十六进制）" Margin="0,0,0,12" />
            <WrapPanel>
                <jv:ComboBox Width="120" atc:TitleAssist.Title="编码"
                             ItemsSource="{Binding Source={StaticResource EncodingChoices}}" SelectedItem="{Binding PayloadEncoding}" />
                <jv:ComboBox Width="180" atc:TitleAssist.Title="校验"
                             ItemsSource="{Binding Source={StaticResource ChecksumKinds}}" SelectedItem="{Binding Checksum}" />
            </WrapPanel>
            <WrapPanel Margin="0,4,0,4">
                <jv:Button Content="发送" Command="{Binding SendCommand}" Margin="0,0,8,12" />
                <jv:Button Content="请求" Command="{Binding RequestCommand}" Margin="0,0,8,12" />
                <jv:Button Content="接收一帧" Command="{Binding ReceiveCommand}" Margin="0,0,8,12" />
            </WrapPanel>

            <jv:GroupBox Header="定时发送" IsCollapsible="True" IsCollapsed="True">
                <StackPanel>
                    <WrapPanel>
                        <jv:TextBox Width="120" atc:TitleAssist.Title="间隔（毫秒）"
                                    Text="{Binding PeriodicIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                        <jv:TextBox Width="120" atc:TitleAssist.Title="次数（0 为不限）"
                                    Text="{Binding PeriodicCount, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                    <WrapPanel>
                        <jv:Button Content="开始定时发送" Command="{Binding StartPeriodicCommand}" Margin="0,0,8,12" />
                        <jv:Button Content="停止" Command="{Binding StopPeriodicCommand}" Margin="0,0,8,12" />
                    </WrapPanel>
                </StackPanel>
            </jv:GroupBox>

            <jv:GroupBox Header="发送历史" IsCollapsible="True" IsCollapsed="True">
                <jv:ListBox ItemsSource="{Binding SendHistory}" MaxHeight="140" />
            </jv:GroupBox>
        </StackPanel>
    </Border>
</UserControl>
