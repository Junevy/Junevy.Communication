<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Channels.SendPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:common="clr-namespace:Junevy.Communication.DebugAssistant.Common;assembly=Junevy.Communication.DebugAssistant">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：发送内容、发送、请求、接收，以及定时发送 -->
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBox Text="{Binding PayloadText, UpdateSourceTrigger=PropertyChanged}" Height="60" AcceptsReturn="True" />
            <WrapPanel Margin="0,6,0,0">
                <Label Content="编码" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Source={StaticResource EncodingChoices}}" SelectedItem="{Binding PayloadEncoding}" Width="110" Margin="0,0,12,0" />
                <Label Content="校验" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Source={StaticResource ChecksumKinds}}" SelectedItem="{Binding Checksum}" Width="150" />
            </WrapPanel>
            <WrapPanel Margin="0,6,0,0">
                <jv:Button Content="发送" Command="{Binding SendCommand}" Margin="0,0,8,0" />
                <jv:Button Content="请求" Command="{Binding RequestCommand}" Margin="0,0,8,0" />
                <jv:Button Content="接收一帧" Command="{Binding ReceiveCommand}" />
            </WrapPanel>
            <WrapPanel Margin="0,10,0,0">
                <Label Content="定时间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding PeriodicIntervalMs, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                <Label Content="次数（0 为不限）" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding PeriodicCount, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                <jv:Button Content="开始定时发送" Command="{Binding StartPeriodicCommand}" Margin="0,0,8,0" />
                <jv:Button Content="停止" Command="{Binding StopPeriodicCommand}" />
            </WrapPanel>
            <TextBlock Text="发送历史" FontWeight="SemiBold" Margin="0,10,0,4" />
            <ListBox ItemsSource="{Binding SendHistory}" MaxHeight="120" />
        </StackPanel>

        <!-- 右：收到的帧 -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="收到的帧" FontWeight="SemiBold" Margin="0,0,0,4" />
            <DataGrid ItemsSource="{Binding ReceivedFrames}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss.fff}" Width="100" />
                    <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="140" />
                    <DataGridTextColumn Header="HEX" Binding="{Binding Hex}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
