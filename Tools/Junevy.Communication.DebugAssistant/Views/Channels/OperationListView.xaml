<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Channels.OperationListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="操作记录" FontWeight="SemiBold" Margin="0,0,0,4" />
        <DataGrid ItemsSource="{Binding Operations}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss.fff}" Width="100" />
                <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="80" />
                <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="130" />
                <DataGridTextColumn Header="结果" Binding="{Binding Succeeded}" Width="60" />
                <DataGridTextColumn Header="错误种类" Binding="{Binding ErrorKindText}" Width="100" />
                <DataGridTextColumn Header="协议码" Binding="{Binding ProtocolCode}" Width="80" />
                <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
