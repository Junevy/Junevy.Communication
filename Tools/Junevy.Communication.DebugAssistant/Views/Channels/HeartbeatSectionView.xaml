<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Channels.HeartbeatSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls">
    <!-- 心跳（通道参数与服务端参数共用）。DataContext 是 HeartbeatEditor。 -->
    <jv:GroupBox Header="心跳" IsCollapsible="True" IsCollapsed="True">
        <StackPanel>
            <jv:CheckBox Content="启用心跳" IsChecked="{Binding Enabled}" />
            <WrapPanel>
                <jv:TextBox Width="120" atc:TitleAssist.Title="间隔（毫秒）"
                            Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" />
                <jv:TextBox Width="120" atc:TitleAssist.Title="超时（毫秒）"
                            Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" />
                <jv:TextBox Width="120" atc:TitleAssist.Title="连续失败次数"
                            Text="{Binding MaxFailures, UpdateSourceTrigger=PropertyChanged}" />
            </WrapPanel>
            <jv:CheckBox Content="仅在空闲时发送" IsChecked="{Binding OnlyWhenIdle}" />
            <WrapPanel>
                <jv:TextBox Width="180" atc:TitleAssist.Title="心跳内容"
                            Text="{Binding Payload, UpdateSourceTrigger=PropertyChanged}" />
                <jv:TextBox Width="180" atc:TitleAssist.Title="期待的应答"
                            Text="{Binding ExpectedReply, UpdateSourceTrigger=PropertyChanged}" />
            </WrapPanel>
        </StackPanel>
    </jv:GroupBox>
</UserControl>
