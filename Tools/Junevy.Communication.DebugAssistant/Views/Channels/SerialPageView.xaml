<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Channels.SerialPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions"
             xmlns:ports="clr-namespace:System.IO.Ports;assembly=System.IO.Ports"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="Parities" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:Parity" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="StopBitOptions" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:StopBits" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="HandshakeOptions" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:Handshake" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <jv:GroupBox Grid.Row="0" Header="串口参数" Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <StackPanel>
                    <WrapPanel>
                        <Label Content="端口" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding AvailablePorts}" Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Width="120" Margin="0,0,6,0" />
                        <jv:Button Content="刷新端口" Command="{Binding RefreshPortsCommand}" Margin="0,0,12,0" />
                        <Label Content="波特率" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,12,0" />
                        <Label Content="数据位" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,12,0" />
                        <Label Content="校验" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource Parities}}" SelectedItem="{Binding Parity}" Width="90" Margin="0,0,12,0" />
                        <Label Content="停止位" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource StopBitOptions}}" SelectedItem="{Binding StopBits}" Width="90" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="流控" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource HandshakeOptions}}" SelectedItem="{Binding Handshake}" Width="140" Margin="0,0,12,0" />
                        <CheckBox Content="DTR" IsChecked="{Binding DtrEnable}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <CheckBox Content="RTS" IsChecked="{Binding RtsEnable}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Label Content="读缓冲" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ReadBufferSize, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="写缓冲" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding WriteBufferSize, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="打开超时（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding OpenTimeout, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </WrapPanel>
                </StackPanel>
            </jv:GroupBox>

            <local:ConnectionBarView Grid.Row="1" Margin="0,0,0,6" />

            <jv:GroupBox Grid.Row="2" Header="通道参数" IsCollapsible="True" IsCollapsed="True" Margin="0,0,0,6"
                         IsEnabled="{Binding IsEditable}">
                <local:ChannelSettingsView DataContext="{Binding Settings}" MaxHeight="360" />
            </jv:GroupBox>

            <TextBlock Grid.Row="3" Margin="0,0,0,4" Foreground="{DynamicResource Theme.Brush.Text.Secondary}"
                       Text="默认分帧为空闲间隔（20 毫秒）。USB 转串口的延迟会让间隔判断不准，必要时加大间隔。启用心跳时必须填写期待的应答（连接时会被拒绝）。" />

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <local:SendPanelView Grid.Column="0" />
                <local:OperationListView Grid.Column="1" Margin="8,0,0,0" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
