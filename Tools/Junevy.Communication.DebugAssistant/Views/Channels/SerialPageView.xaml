<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Channels.SerialPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions"
             xmlns:ports="clr-namespace:System.IO.Ports;assembly=System.IO.Ports"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="Parities" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:Parity" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="StopBitOptions" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:StopBits" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="HandshakeOptions" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:Handshake" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <!-- 布局：顶部连接栏；左侧参数与发送（可滚动，可拖宽）；右侧上方收到的帧，下方为操作记录与报文日志（可拖高）。 -->
    <DockPanel Margin="12">
        <local:ConnectionBarView DockPanel.Dock="Top" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Style="{StaticResource Panel.SettingsScroll}">
                <StackPanel>
                    <jv:TextBlock Style="{StaticResource Text.Hint}"
                                  Text="默认分帧为空闲间隔（20 毫秒）。USB 转串口的延迟会让间隔判断不准，必要时加大间隔。启用心跳时必须填写期待的应答（连接时会被拒绝）。" />

                    <jv:GroupBox Header="端口与通信参数" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <WrapPanel>
                                <jv:ComboBox Width="160" atc:TitleAssist.Title="端口" IsEditable="True"
                                             ItemsSource="{Binding AvailablePorts}"
                                             Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:Button Content="刷新端口" Command="{Binding RefreshPortsCommand}" Margin="0,22,0,12" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="120" atc:TitleAssist.Title="波特率"
                                            Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="100" atc:TitleAssist.Title="数据位"
                                            Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:ComboBox Width="120" atc:TitleAssist.Title="校验"
                                             ItemsSource="{Binding Source={StaticResource Parities}}" SelectedItem="{Binding Parity}" />
                                <jv:ComboBox Width="120" atc:TitleAssist.Title="停止位"
                                             ItemsSource="{Binding Source={StaticResource StopBitOptions}}" SelectedItem="{Binding StopBits}" />
                            </WrapPanel>
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="流控与缓冲" IsCollapsible="True" IsCollapsed="True" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <WrapPanel>
                                <jv:ComboBox Width="160" atc:TitleAssist.Title="流控"
                                             ItemsSource="{Binding Source={StaticResource HandshakeOptions}}" SelectedItem="{Binding Handshake}" />
                                <jv:CheckBox Content="DTR" IsChecked="{Binding DtrEnable}" />
                                <jv:CheckBox Content="RTS" IsChecked="{Binding RtsEnable}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="120" atc:TitleAssist.Title="读缓冲"
                                            Text="{Binding ReadBufferSize, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="120" atc:TitleAssist.Title="写缓冲"
                                            Text="{Binding WriteBufferSize, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="140" atc:TitleAssist.Title="打开超时（毫秒）"
                                            Text="{Binding OpenTimeout, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                        </StackPanel>
                    </jv:GroupBox>

                    <local:SendPanelView />

                    <jv:GroupBox Header="通道参数" IsCollapsible="True" IsCollapsed="True" IsEnabled="{Binding IsEditable}">
                        <local:ChannelSettingsView DataContext="{Binding Settings}" />
                    </jv:GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Columns}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="240" MinHeight="120" />
                </Grid.RowDefinitions>

                <local:ReceivedFramesView Grid.Row="0" />

                <GridSplitter Grid.Row="1" Style="{StaticResource Splitter.Rows}" />

                <TabControl Grid.Row="2">
                    <TabItem Header="操作记录">
                        <local:OperationListView Margin="8" />
                    </TabItem>
                    <TabItem Header="报文与日志">
                        <sessions:LogPanel DataContext="{Binding LogPanel}" Margin="8" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
