<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Ftp.FtpPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- FTP/FTPS 页（计划第 7.12 节）：连接选项、远程浏览、上传与下载（进度）、文件与目录操作；公共面板。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:ConnectionBarView Grid.Row="0" Margin="0,0,0,6" />

            <!-- 连接选项：运行中不可修改。密码只在内存中，不写入工作区。 -->
            <jv:GroupBox Grid.Row="1" Header="连接选项" Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <StackPanel>
                    <WrapPanel>
                        <Label Content="主机" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,12,0" />
                        <Label Content="端口" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                        <Label Content="用户名（留空为匿名）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,12,0" />
                        <Label Content="密码（不保存）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <jv:PasswordBox Password="{Binding Password, Mode=TwoWay}" Width="130" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="加密" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding EncryptionChoices}" SelectedItem="{Binding Encryption}" Width="110" Margin="0,0,12,0" />
                        <TextBlock Text="隐式 FTPS 通常使用端口 990；本页不会自动修改端口，请自行填写。"
                                   Visibility="{Binding IsImplicit, Converter={StaticResource BoolToVisibility}}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <CheckBox Content="允许不受信任的证书（包括主机名不匹配）" IsChecked="{Binding AllowUntrustedCertificates}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Label Content="文件名编码（如 GBK）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding EncodingName, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="连接超时（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ConnectTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="读取超时（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ReadTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="数据连接超时（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding DataConnectionTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </WrapPanel>
                </StackPanel>
            </jv:GroupBox>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：远程浏览与传输。双击目录进入；上传与下载在当前目录进行。 -->
                <jv:GroupBox Grid.Column="0" Header="远程目录" Margin="0,0,6,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding LinkStateText, StringFormat=连接：{0}}" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentDirectory, StringFormat=当前目录：{0}}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                            <jv:Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                            <jv:Button Content="上级目录" Command="{Binding GoUpCommand}" Margin="0,0,6,0" />
                            <jv:Button Content="上传" Command="{Binding UploadCommand}" Margin="0,0,6,0" />
                            <jv:Button Content="下载选中文件" Command="{Binding DownloadCommand}" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding ExistsModeChoices}" SelectedItem="{Binding ExistsMode}" Width="110" ToolTip="目标已存在时：覆盖或跳过" />
                        </WrapPanel>
                        <jv:ProgressBar DockPanel.Dock="Top" Margin="0,6,0,0" Height="14"
                                        Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsIndeterminate="{Binding ProgressIndeterminate}" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ProgressText}" Margin="0,2,0,0" />
                        <TextBlock DockPanel.Dock="Top" Text="修改时间是服务器报告的时间，未做时区转换。" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" Margin="0,4,0,0" />
                        <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,4,0,0"
                                  MouseDoubleClick="OnEntryDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="60" />
                                <DataGridTextColumn Header="大小（字节）" Binding="{Binding Size}" Width="90" />
                                <DataGridTextColumn Header="修改时间" Binding="{Binding Modified}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </jv:GroupBox>

                <!-- 右：文件与目录操作。递归删除需要确认；重命名与新建目录都在当前目录下进行。 -->
                <jv:GroupBox Grid.Column="1" Header="文件与目录操作" Margin="6,0,0,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <TextBox Text="{Binding NewDirectoryName, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,6,0" ToolTip="可以写多级路径，例如 a/b，会逐级创建" />
                            <jv:Button Content="新建目录" Command="{Binding CreateDirectoryCommand}" />
                        </WrapPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                            <TextBox Text="{Binding RenameTo, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,6,0" ToolTip="新名称（同一目录下）" />
                            <jv:Button Content="重命名选中项" Command="{Binding RenameCommand}" />
                        </WrapPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                            <jv:Button Content="删除选中的文件" Command="{Binding DeleteFileCommand}" Margin="0,0,6,0" />
                            <jv:Button Content="递归删除选中的目录（需确认）" Command="{Binding DeleteDirectoryCommand}" Margin="0,0,6,0" />
                            <jv:Button Content="检查存在与大小" Command="{Binding CheckSelectedCommand}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding OperationMessage}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock DockPanel.Dock="Top" Text="同一个客户端的操作按顺序排队执行；连接中断后下次操作会按需重连。" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" Margin="0,8,0,0" />
                    </DockPanel>
                </jv:GroupBox>
            </Grid>

            <!-- 操作记录：每次列目录、传输与修改的结果与错误种类 -->
            <Border Grid.Row="3" Margin="0,6,0,0" Height="160">
                <local:OperationListView />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
