<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Plc.PlcPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:plc="clr-namespace:Junevy.Communication.DebugAssistant.Protocols.Plc"
             xmlns:core="clr-namespace:Junevy.Communication.Core.Buffers;assembly=Junevy.Communication.Core"
             xmlns:common="clr-namespace:Junevy.Communication.DebugAssistant.Common;assembly=Junevy.Communication.DebugAssistant">
    <!-- PLC 公共面板（计划第 7.1 节）：地址与类型化读写、套件选项、监控表。协议页签的 DataContext 是页签的视图模型。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ObjectDataProvider x:Key="ValueTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="plc:PlcValueType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="WordOrders" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="core:WordOrder" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="EncodingChoices" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="common:EncodingChoice" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 地址、类型与读写 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <WrapPanel>
                <Label Content="地址" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,12,0" />
                <Label Content="类型" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Source={StaticResource ValueTypes}}" SelectedItem="{Binding ValueType}" Width="110" Margin="0,0,12,0" />
                <Label Content="数量或长度" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                <jv:Button Content="读取" Command="{Binding ReadCommand}" Margin="0,0,8,0" />
                <jv:Button Content="写入" Command="{Binding WriteCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding AddressCheck}" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <WrapPanel Margin="0,4,0,0">
                <Label Content="写入的值（逗号分隔）" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding WriteText, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,12,0" />
                <Label Content="读取结果" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding ReadText, Mode=OneWay}" IsReadOnly="True" Width="260" />
            </WrapPanel>
        </StackPanel>

        <!-- 套件选项：字序与字符串编码由协议决定，这里只在覆盖时生效；界面标出协议的默认值。 -->
        <jv:GroupBox Grid.Row="1" Header="套件选项" IsCollapsible="True" IsCollapsed="True" Margin="0,0,0,6">
            <StackPanel DataContext="{Binding Options}">
                <WrapPanel>
                    <Label Content="重试次数" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0" />
                    <Label Content="重试间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding RetryIntervalMs, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,12,0" />
                    <CheckBox Content="允许读改写位（有风险）" IsChecked="{Binding AllowReadModifyWriteBits}" VerticalAlignment="Center" />
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <CheckBox Content="覆盖字序" IsChecked="{Binding OverrideWordOrder}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Source={StaticResource WordOrders}}" SelectedItem="{Binding WordOrder}" Width="100" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ProtocolWordOrder, StringFormat=协议默认 {0}}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <CheckBox Content="覆盖字符串编码" IsChecked="{Binding OverrideEncoding}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Source={StaticResource EncodingChoices}}" SelectedItem="{Binding StringEncoding}" Width="100" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ProtocolEncoding, StringFormat=协议默认 {0}}" VerticalAlignment="Center" />
                </WrapPanel>
            </StackPanel>
        </jv:GroupBox>

        <!-- 监控表 -->
        <DockPanel Grid.Row="2">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <jv:Button Content="添加到监控表" Command="{Binding AddMonitorCommand}" Margin="0,0,8,0" />
                <Label Content="轮询间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding MonitorIntervalMs, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,8,0" />
                <jv:Button Content="开始监控" Command="{Binding StartMonitorCommand}" Margin="0,0,8,0" />
                <jv:Button Content="停止监控" Command="{Binding StopMonitorCommand}" />
                <TextBlock Text="监控中" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
            <DataGrid ItemsSource="{Binding Monitor}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="120" IsReadOnly="True" />
                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="数量或长度" Binding="{Binding Count}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="新值" Binding="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="180" IsReadOnly="True" />
                    <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt, StringFormat=HH:mm:ss.fff}" Width="100" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="操作" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <jv:Button Content="写入新值"
                                               Command="{Binding DataContext.WriteMonitorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" Margin="0,0,6,0" />
                                    <jv:Button Content="删除"
                                               Command="{Binding DataContext.RemoveMonitorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
