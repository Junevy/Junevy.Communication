<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Mqtt.MqttPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- MQTT 客户端页（计划第 7.7 节）：连接、TLS、重连与遗嘱；订阅；发布（文本或十六进制、QoS、Retain、MQTT 5 属性）；接收列表。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:ConnectionBarView Grid.Row="0" Margin="0,0,0,6" />

            <!-- 连接选项：运行中不可修改（库在创建时取快照）。密码只在内存中，不写入工作区。 -->
            <jv:GroupBox Grid.Row="1" Header="连接选项" Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <StackPanel>
                    <WrapPanel>
                        <Label Content="地址" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,12,0" />
                        <Label Content="端口" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                        <Label Content="客户端标识（留空由库生成）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,12,0" />
                        <Label Content="用户名" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,12,0" />
                        <Label Content="密码（不保存）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <jv:PasswordBox Password="{Binding Password, Mode=TwoWay}" Width="130" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="协议版本（V311 为 3.1.1，V500 为 5.0）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding VersionChoices}" SelectedItem="{Binding ProtocolVersion}" Width="100" Margin="0,0,12,0" />
                        <CheckBox Content="清理会话（CleanSession）" IsChecked="{Binding CleanSession}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Label Content="会话过期（秒，仅 V5.0）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding SessionExpiryInterval, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsVersion500}" Width="90" Margin="0,0,12,0" />
                        <Label Content="保活（秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding KeepAliveSeconds, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                        <Label Content="超时（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox Content="TLS" IsChecked="{Binding UseTls}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <CheckBox Content="允许不受信任的证书（包括主机名不匹配）" IsChecked="{Binding AllowUntrustedCertificates}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="警告：开启后任何证书都会被接受，连接不再验证服务器身份，只用于测试。"
                                   Visibility="{Binding AllowUntrustedCertificates, Converter={StaticResource BoolToVisibility}}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox Content="自动重连并恢复订阅" IsChecked="{Binding AutoReconnect}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Label Content="重连间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ReconnectInterval, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="最大重连间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MaxReconnectInterval, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="遗嘱主题" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding WillTopic, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,12,0" />
                        <Label Content="遗嘱内容（文本）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding WillPayload, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,12,0" />
                        <Label Content="遗嘱 QoS" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding QosChoices}" SelectedItem="{Binding WillQos}" Width="110" Margin="0,0,12,0" />
                        <CheckBox Content="遗嘱保留（Retain）" IsChecked="{Binding WillRetain}" VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
            </jv:GroupBox>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：连接状态与订阅 -->
                <jv:GroupBox Grid.Column="0" Header="订阅" Margin="0,0,6,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding MqttStateText, StringFormat=连接状态：{0}}" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding StateReason}" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />
                        <WrapPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                            <TextBox Text="{Binding NewTopicFilter, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding QosChoices}" SelectedItem="{Binding NewSubscribeQos}" Width="100" Margin="0,0,6,0" />
                            <jv:Button Content="订阅" Command="{Binding SubscribeCommand}" Margin="0,0,6,0" />
                            <jv:Button Content="退订选中项" Command="{Binding UnsubscribeCommand}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="支持通配符 + 与 #。Broker 授予的 QoS 可能低于请求的 QoS。" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SubscriptionMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <DataGrid ItemsSource="{Binding Subscriptions}" SelectedItem="{Binding SelectedSubscription, Mode=TwoWay}"
                                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="主题过滤器" Binding="{Binding TopicFilter}" Width="*" />
                                <DataGridTextColumn Header="请求 QoS" Binding="{Binding RequestedText}" Width="90" />
                                <DataGridTextColumn Header="授予 QoS" Binding="{Binding GrantedText}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </jv:GroupBox>

                <!-- 右：发布（含 MQTT 5 属性）与接收列表 -->
                <Grid Grid.Column="1" Margin="6,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <jv:GroupBox Grid.Row="0" Header="发布" Margin="0,0,0,6">
                        <StackPanel>
                            <WrapPanel>
                                <Label Content="主题" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding PublishTopic, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,12,0" />
                                <Label Content="QoS" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding QosChoices}" SelectedItem="{Binding PublishQos}" Width="100" Margin="0,0,12,0" />
                                <CheckBox Content="Retain" IsChecked="{Binding PublishRetain}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <CheckBox Content="负载按十六进制输入（如 0A FF）" IsChecked="{Binding PublishPayloadAsHex}" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBox Text="{Binding PublishPayload, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AcceptsReturn="True" Height="48" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,4,0,0">
                                <Label Content="ContentType" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding ContentType, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,12,0" />
                                <Label Content="ResponseTopic" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding ResponseTopic, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,12,0" />
                                <Label Content="CorrelationData（十六进制）" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding CorrelationDataHex, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,12,0" />
                                <Label Content="过期间隔（秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding MessageExpiryText, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            </WrapPanel>
                            <TextBlock Text="V3.1.1 连接上发布带 MQTT 5 属性的消息会返回 InvalidRequest，并且不会发送；这里可以看到这个结果。"
                                       Visibility="{Binding IsVersion311, Converter={StaticResource BoolToVisibility}}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" Margin="0,4,0,0" />
                            <WrapPanel Margin="0,4,0,0">
                                <Label Content="用户属性：名称" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding NewUserPropertyName, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,6,0" />
                                <Label Content="值" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding NewUserPropertyValue, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,6,0" />
                                <jv:Button Content="添加属性" Command="{Binding AddUserPropertyCommand}" Margin="0,0,6,0" />
                                <jv:Button Content="删除选中属性" Command="{Binding RemoveUserPropertyCommand}"
                                           CommandParameter="{Binding SelectedUserProperty}" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding PublishUserProperties}" SelectedItem="{Binding SelectedUserProperty, Mode=TwoWay}"
                                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="90" Margin="0,4,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,4,0,0">
                                <jv:Button Content="发布" Command="{Binding PublishCommand}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding PublishMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </WrapPanel>
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Grid.Row="1" Header="接收">
                        <DockPanel>
                            <jv:Button DockPanel.Dock="Top" Content="清空接收列表" Command="{Binding ClearReceivedCommand}" HorizontalAlignment="Left" />
                            <DataGrid ItemsSource="{Binding ReceivedMessages}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                      Margin="0,4,0,0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="90" />
                                    <DataGridTextColumn Header="主题" Binding="{Binding Topic}" Width="120" />
                                    <DataGridTextColumn Header="QoS" Binding="{Binding Qos}" Width="60" />
                                    <DataGridTextColumn Header="Retain" Binding="{Binding Retain}" Width="60" />
                                    <DataGridTextColumn Header="负载（文本）" Binding="{Binding PayloadText}" Width="*" />
                                    <DataGridTextColumn Header="负载（十六进制）" Binding="{Binding PayloadHex}" Width="*" />
                                    <DataGridTextColumn Header="MQTT 5 属性" Binding="{Binding Properties}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </jv:GroupBox>
                </Grid>
            </Grid>

            <!-- 操作记录：连接、订阅、发布的结果与错误种类 -->
            <Border Grid.Row="3" Margin="0,6,0,0" Height="160">
                <local:OperationListView />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
