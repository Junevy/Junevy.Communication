<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:jv="github.com.junevy">
    <!--
      调试助手的界面间距与层次（所有页签共用）：
      - 输入项之间留 16 / 12 DIP；标题放在输入框上方（atc:TitleAssist，默认 Top），不再使用"标签 + 输入框"并排；
      - 每组设置放在 jv:GroupBox 中，次要参数默认折叠；
      - 文字层次：分组标题（GroupBox）> 小节标题（Text.Section）> 字段标题（TitleAssist，次级色）> 提示（Text.Hint，三级色）。
    -->
    <Style TargetType="{x:Type jv:GroupBox}" BasedOn="{StaticResource {x:Type jv:GroupBox}}">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style TargetType="{x:Type jv:TextBox}" BasedOn="{StaticResource {x:Type jv:TextBox}}">
        <Setter Property="Margin" Value="0,0,16,12" />
        <Setter Property="ShowClear" Value="False" />
    </Style>

    <Style TargetType="{x:Type jv:ComboBox}" BasedOn="{StaticResource {x:Type jv:ComboBox}}">
        <Setter Property="Margin" Value="0,0,16,12" />
    </Style>

    <Style TargetType="{x:Type jv:PasswordBox}" BasedOn="{StaticResource {x:Type jv:PasswordBox}}">
        <Setter Property="Margin" Value="0,0,16,12" />
    </Style>

    <Style TargetType="{x:Type jv:CheckBox}" BasedOn="{StaticResource {x:Type jv:CheckBox}}">
        <Setter Property="Margin" Value="0,0,16,12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Text.Section" TargetType="{x:Type jv:TextBlock}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,4,0,8" />
    </Style>

    <Style x:Key="Text.Hint" TargetType="{x:Type jv:TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Brush.Text.Tertiary}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Panel.Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Theme.Brush.Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Brush.Border.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!--
      页签的分区（所有页签共用）：左侧参数列 | Splitter.Columns | 右侧工作区；工作区内 主区 | Splitter.Rows | 底部活动区。
      分隔条 12 DIP 宽，可拖动调整两侧大小；中间一条细线提示位置，悬停或拖动时变为主色。
    -->
    <Style x:Key="Splitter.Base" TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    </Style>

    <Style x:Key="Splitter.Columns" TargetType="{x:Type GridSplitter}" BasedOn="{StaticResource Splitter.Base}">
        <Setter Property="Width" Value="12" />
        <Setter Property="ResizeDirection" Value="Columns" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Border Background="{TemplateBinding Background}">
                        <Border x:Name="Line" Width="2" CornerRadius="1" HorizontalAlignment="Center"
                                Background="{DynamicResource Theme.Brush.Border.Divider}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Splitter.Rows" TargetType="{x:Type GridSplitter}" BasedOn="{StaticResource Splitter.Base}">
        <Setter Property="Height" Value="12" />
        <Setter Property="ResizeDirection" Value="Rows" />
        <Setter Property="Cursor" Value="SizeNS" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Border Background="{TemplateBinding Background}">
                        <Border x:Name="Line" Height="2" CornerRadius="1" VerticalAlignment="Center"
                                Background="{DynamicResource Theme.Brush.Border.Divider}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource Theme.Brush.Accent.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 左侧参数列：竖向滚动，右边留出滚动条的位置。 -->
    <Style x:Key="Panel.SettingsScroll" TargetType="{x:Type ScrollViewer}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="0,0,8,0" />
    </Style>
</ResourceDictionary>
