<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Fins.FinsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:plcViews="clr-namespace:Junevy.Communication.DebugAssistant.Views.Plc"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- FINS 页签（计划第 7.5 节）：节点与路由、握手结果、区域速查表与说明；公共面板。 -->
    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 连接地址与节点、路由 -->
            <jv:GroupBox Grid.Row="0" Header="节点与路由（FINS/TCP，端口 9600）" Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <StackPanel>
                    <WrapPanel>
                        <Label Content="主机" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,12,0" />
                        <Label Content="端口" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                        <Label Content="客户端节点" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ClientNode, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0" />
                        <Label Content="目的网络" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding DestinationNetwork, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0" />
                        <Label Content="目的单元" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding DestinationUnit, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                    </WrapPanel>
                    <TextBlock Text="客户端节点：0 由 CPU 分配，1 到 254 为固定节点，255 是广播地址被拒绝。" Margin="0,4,0,0"
                               Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding HandshakeText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </jv:GroupBox>

            <local:ConnectionBarView Grid.Row="1" Margin="0,0,0,6" />

            <jv:GroupBox Grid.Row="2" Header="通道参数（超时、心跳、重连、套接字与 TLS）" IsCollapsible="True" IsCollapsed="True" Margin="0,0,0,6"
                         IsEnabled="{Binding IsEditable}">
                <local:ChannelSettingsView DataContext="{Binding Channel}" MaxHeight="360" />
            </jv:GroupBox>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- 左：公共面板 -->
                <plcViews:PlcPanelView Grid.Column="0" Margin="0,0,8,0" />

                <!-- 右：区域速查表与说明 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <jv:GroupBox Header="区域速查表（地址与位号为十进制，区域代码为十六进制）" Margin="0,0,0,8">
                            <DataGrid x:Name="AreaGrid" ItemsSource="{Binding Areas}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                      MaxHeight="300" VirtualizingPanel.IsVirtualizing="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="区域" Binding="{Binding Symbol}" Width="70" />
                                    <DataGridTextColumn Header="字区代码" Binding="{Binding WordAreaCodeText}" Width="90" />
                                    <DataGridTextColumn Header="位区代码" Binding="{Binding BitAreaCodeText}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </jv:GroupBox>

                        <jv:GroupBox Header="说明" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Text="地址格式为“区域 + 编号 + .位号”，编号与位号都是十进制，例如 D100、W10.03、E3_200.15。位号 0 到 15，写 16 或更大会被拒绝。" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="位写入是原生的：WriteBitsAsync(“W10.15”, …) 写多个位时，第二个位落在下一字 W11.0，报文使用位区代码。" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="字节语义与 MC 相反：ReadByteAsync 返回字的高字节，而不是低字节。" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="结束码：状态位先被屏蔽（主字节取低 7 位，次字节取低 6 位），屏蔽后为 0 视为成功；协议码显示的是屏蔽后的结束码。结束码的含义取决于 CPU 型号，请查阅欧姆龙 FINS 手册。" />
                            </StackPanel>
                        </jv:GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 操作记录 -->
            <Border Grid.Row="4" Margin="0,6,0,0" Height="160">
                <local:OperationListView />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
