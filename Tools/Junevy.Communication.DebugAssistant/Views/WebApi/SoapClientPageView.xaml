<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.WebApi.SoapClientPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- SOAP 客户端页（计划第 7.10 节）：连接选项、原始调用（SOAPAction 与 XML 正文）、Fault 与远端码、事件时间线与可用性；公共面板。 -->
    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:ConnectionBarView Grid.Row="0" Margin="0,0,0,6" />

            <!-- 连接选项：运行中不可修改。认证与重试、日志与 REST 客户端页相同。 -->
            <jv:GroupBox Grid.Row="1" Header="连接选项（认证只填环境变量名）" Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <StackPanel>
                    <WrapPanel>
                        <Label Content="地址" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,12,0" />
                        <Label Content="版本" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding VersionChoices}" SelectedItem="{Binding Version}" Width="90" Margin="0,0,12,0" />
                        <Label Content="默认命名空间" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding DefaultNamespace, UpdateSourceTrigger=PropertyChanged}" Width="230" Margin="0,0,12,0" />
                        <Label Content="超时（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="健康检查地址（与地址同主机与端口）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding HealthCheckUrl, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,12,0" />
                        <Label Content="检查间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding HealthCheckIntervalMs, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="离线阈值（次）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding OfflineThreshold, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="认证" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding AuthChoices}" SelectedItem="{Binding AuthScheme}" Width="100" Margin="0,0,12,0" />
                        <Label Content="用户名变量" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding UserNameVariable, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,12,0" />
                        <Label Content="密码变量" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding PasswordVariable, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,12,0" />
                        <Label Content="令牌变量" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding TokenVariable, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,12,0" />
                        <Label Content="API Key 变量" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ApiKeyVariable, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="重试次数" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0" />
                        <Label Content="重试间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding RetryDelayMs, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <CheckBox Content="重试不安全的方法（Fault 永不重试）" IsChecked="{Binding RetryUnsafeMethods}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <CheckBox Content="记录正文" IsChecked="{Binding LogBodies}" VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
            </jv:GroupBox>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：原始调用。SOAPAction 与正文都是 XML 文本，正文的根元素即 Body 的第一个子元素。 -->
                <jv:GroupBox Grid.Column="0" Header="调用" Margin="0,0,6,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <Label Content="SOAPAction" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding SoapAction, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,12,0" />
                            <jv:Button Content="发送" Command="{Binding SendCommand}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding RequestMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock DockPanel.Dock="Top" Text="正文（XML，Body 的第一个子元素）" Margin="0,4,0,0" />
                        <jv:CodeEditor Text="{Binding BodyXml, Mode=TwoWay}" SyntaxLanguage="Xml" />
                    </DockPanel>
                </jv:GroupBox>

                <!-- 右：响应、Fault、可用性与时间线。 -->
                <jv:GroupBox Grid.Column="1" Header="响应与时间线" Margin="6,0,0,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding AvailabilityText, StringFormat=可用性：{0}}" FontWeight="SemiBold" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding ResponseStatus, StringFormat=HTTP 状态：{0}}" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding ResponseRemoteCode, StringFormat=远端码（Fault 码）：{0}}" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding ResponseErrorKind, StringFormat=结果：{0}}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ResponseMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock DockPanel.Dock="Top" Text="响应 XML" Margin="0,4,0,0" />
                        <jv:CodeEditor Text="{Binding ResponseXml, Mode=OneWay}" SyntaxLanguage="Xml" IsReadOnly="True" Height="140" />
                        <jv:Button DockPanel.Dock="Top" Content="清空时间线" Command="{Binding ClearTimelineCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        <DataGrid ItemsSource="{Binding Timeline}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,4,0,0"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="90" />
                                <DataGridTextColumn Header="事件" Binding="{Binding Event}" Width="70" />
                                <DataGridTextColumn Header="尝试" Binding="{Binding Attempt}" Width="50" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="60" />
                                <DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </jv:GroupBox>
            </Grid>

            <!-- 操作记录：每次调用的结果与错误种类 -->
            <Border Grid.Row="3" Margin="0,6,0,0" Height="160">
                <local:OperationListView />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
