<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.WebApi.WebApiServerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- WebApi 服务端页（计划第 7.11 节）：监听、认证、限制、业务信封、去重、HTTPS、路由表与请求日志；公共面板。 -->
    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:ConnectionBarView Grid.Row="0" Margin="0,0,0,6" />

            <!-- 服务端参数：运行中不可修改（库在启动时取快照）。端口写 0 时由系统分配，启动后在右侧显示实际地址。 -->
            <jv:GroupBox Grid.Row="1" Header="服务端参数（运行中不可修改）" Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <StackPanel>
                    <WrapPanel>
                        <Label Content="监听地址（每行一个）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding UrlsText, UpdateSourceTrigger=PropertyChanged}" Width="220" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,12,0" />
                        <Label Content="认证" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding AuthChoices}" SelectedItem="{Binding AuthScheme}" Width="100" Margin="0,0,12,0" />
                        <Label Content="用户名变量" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding UserNameVariable, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,12,0" />
                        <Label Content="密码变量" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding PasswordVariable, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="令牌变量（Bearer）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding TokenVariable, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,12,0" />
                        <Label Content="API Key 头" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ApiKeyHeader, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,12,0" />
                        <Label Content="API Key 变量" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ApiKeyVariable, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,12,0" />
                        <Label Content="HTTPS 证书（.pfx）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding CertificatePath, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,12,0" />
                        <Label Content="证书口令变量" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding CertificatePasswordVariable, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="最大并发" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MaxConcurrentRequests, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0" />
                        <Label Content="请求超时（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding RequestTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="正文上限（字节）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MaxRequestBodySize, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,12,0" />
                        <Label Content="停止等待（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding StopTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="业务失败状态码" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding BusinessFailureStatusCode, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox Content="业务信封" IsChecked="{Binding EnvelopeEnabled}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Label Content="码路径" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding CodePath, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,12,0" />
                        <Label Content="消息路径" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MessagePath, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,12,0" />
                        <Label Content="数据路径" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding DataPath, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,12,0" />
                        <Label Content="成功码（逗号分隔）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding SuccessCodesText, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox Content="幂等去重" IsChecked="{Binding DeduplicationEnabled}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Label Content="幂等键头" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding DeduplicationHeaderName, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,12,0" />
                        <Label Content="窗口（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding DeduplicationWindowMs, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,12,0" />
                        <Label Content="最多条数" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding DeduplicationMaxEntries, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                        <CheckBox Content="记录正文" IsChecked="{Binding LogBodies}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="脱敏请求头" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding RedactedHeadersText, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,12,0" />
                        <Label Content="脱敏查询参数" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding RedactedQueryParametersText, UpdateSourceTrigger=PropertyChanged}" Width="260" />
                    </WrapPanel>
                </StackPanel>
            </jv:GroupBox>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：路由表。运行中不能修改（库要求启动前注册）。 -->
                <jv:GroupBox Grid.Column="0" Header="路由表（运行中不能修改）" Margin="0,0,6,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <ComboBox ItemsSource="{Binding MethodChoices}" SelectedItem="{Binding NewRouteMethod}" Width="80" Margin="0,0,6,0" />
                            <TextBox Text="{Binding NewRouteTemplate, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding KindChoices}" SelectedItem="{Binding NewRouteKind}" Width="110" Margin="0,0,6,0" />
                            <TextBox Text="{Binding NewRouteStatusCode, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,6,0" />
                            <TextBox Text="{Binding NewRouteDelayMs, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,6,0" />
                            <jv:Button Content="登记（同一方法与模板替换）" Command="{Binding AddRouteCommand}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="JSON 正文（固定 JSON 与指定状态码）" Margin="0,4,0,0" />
                        <TextBox DockPanel.Dock="Top" Text="{Binding NewRouteJson, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="50" FontFamily="Consolas" />
                        <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                            <Label Content="业务码" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding NewRouteCode, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,12,0" />
                            <Label Content="消息" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding NewRouteMessage, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding RouteMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <jv:Button DockPanel.Dock="Top" Content="删除选中的路由" Command="{Binding RemoveRouteCommand}" CommandParameter="{Binding SelectedRoute}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <DataGrid x:Name="RouteGrid" ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,4,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="60" />
                                <DataGridTextColumn Header="模板" Binding="{Binding Template}" Width="*" />
                                <DataGridTextColumn Header="响应" Binding="{Binding KindText}" Width="90" />
                                <DataGridTextColumn Header="状态码" Binding="{Binding StatusCode}" Width="60" />
                                <DataGridTextColumn Header="延迟（毫秒）" Binding="{Binding DelayMs}" Width="80" />
                                <DataGridTextColumn Header="业务码" Binding="{Binding Code}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </jv:GroupBox>

                <!-- 右：状态、实际监听地址与请求日志。 -->
                <jv:GroupBox Grid.Column="1" Header="状态与请求日志" Margin="6,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ServerStateText, StringFormat=服务端状态：{0}}" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" Text="实际监听地址" Margin="0,4,0,0" />
                        <TextBox DockPanel.Dock="Top" Text="{Binding BoundUrls, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />
                        <jv:Button DockPanel.Dock="Top" Content="清空请求日志" Command="{Binding ClearRequestLogCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        <DataGrid ItemsSource="{Binding RequestLog}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,4,0,0"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="90" />
                                <DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="60" />
                                <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" />
                                <DataGridTextColumn Header="路由" Binding="{Binding Route}" Width="*" />
                                <DataGridTextColumn Header="结果" Binding="{Binding Outcome}" Width="80" />
                                <DataGridTextColumn Header="状态码" Binding="{Binding Status}" Width="60" />
                                <DataGridTextColumn Header="耗时" Binding="{Binding Elapsed}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </jv:GroupBox>
            </Grid>

            <!-- 操作记录：启动与停止的结果 -->
            <Border Grid.Row="3" Margin="0,6,0,0" Height="160">
                <local:OperationListView />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
