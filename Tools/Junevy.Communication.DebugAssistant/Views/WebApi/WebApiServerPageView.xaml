<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.WebApi.WebApiServerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- WebApi 服务端页（计划第 7.11 节）：左侧为服务端参数、路由登记与可选策略（运行中不可修改，库在启动时取快照）；中间为路由表；右侧为服务端状态、实际监听地址与请求日志；底部为报文与日志。 -->
    <DockPanel Margin="12">
        <jv:ExpanderPanel DockPanel.Dock="Bottom" DisplayMode="Card" Header="报文与日志" IsExpanded="False" Margin="0,12,0,0">
            <sessions:LogPanel DataContext="{Binding LogPanel}" Height="200" />
        </jv:ExpanderPanel>

        <local:ConnectionBarView DockPanel.Dock="Top" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：服务端参数、路由登记与可选策略。端口写 0 时由系统分配，启动后在右侧显示实际地址。 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <jv:GroupBox Header="服务端参数（运行中不可修改）" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <jv:TextBox atc:TitleAssist.Title="监听地址（每行一个）" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                                        Text="{Binding UrlsText, UpdateSourceTrigger=PropertyChanged}" />
                            <WrapPanel>
                                <jv:TextBox Width="110" atc:TitleAssist.Title="最大并发"
                                            Text="{Binding MaxConcurrentRequests, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="130" atc:TitleAssist.Title="请求超时（毫秒）"
                                            Text="{Binding RequestTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="130" atc:TitleAssist.Title="正文上限（字节）"
                                            Text="{Binding MaxRequestBodySize, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="130" atc:TitleAssist.Title="停止等待（毫秒）"
                                            Text="{Binding StopTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="登记路由">
                        <StackPanel>
                            <WrapPanel>
                                <jv:ComboBox Width="90" atc:TitleAssist.Title="方法"
                                             ItemsSource="{Binding MethodChoices}" SelectedItem="{Binding NewRouteMethod}" />
                                <jv:TextBox Width="170" atc:TitleAssist.Title="模板"
                                            Text="{Binding NewRouteTemplate, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:ComboBox Width="110" atc:TitleAssist.Title="响应"
                                             ItemsSource="{Binding KindChoices}" SelectedItem="{Binding NewRouteKind}" />
                                <jv:TextBox Width="60" atc:TitleAssist.Title="状态码"
                                            Text="{Binding NewRouteStatusCode, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="100" atc:TitleAssist.Title="延迟（毫秒）"
                                            Text="{Binding NewRouteDelayMs, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="90" atc:TitleAssist.Title="业务码"
                                            Text="{Binding NewRouteCode, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <jv:TextBox atc:TitleAssist.Title="消息"
                                        Text="{Binding NewRouteMessage, UpdateSourceTrigger=PropertyChanged}" />
                            <jv:TextBox atc:TitleAssist.Title="JSON 正文（固定 JSON 与指定状态码）" Height="70" AcceptsReturn="True"
                                        TextWrapping="Wrap" FontFamily="Consolas"
                                        Text="{Binding NewRouteJson, UpdateSourceTrigger=PropertyChanged}" />
                            <jv:Button Content="登记（同一方法与模板替换）" Command="{Binding AddRouteCommand}"
                                       HorizontalAlignment="Left" Margin="0,0,0,12" />
                            <jv:TextBlock Text="{Binding RouteMessage}" Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="认证与证书" IsCollapsible="True" IsCollapsed="True" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <jv:ComboBox Width="120" atc:TitleAssist.Title="认证"
                                         ItemsSource="{Binding AuthChoices}" SelectedItem="{Binding AuthScheme}" />
                            <WrapPanel>
                                <jv:TextBox Width="130" atc:TitleAssist.Title="用户名变量"
                                            Text="{Binding UserNameVariable, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="130" atc:TitleAssist.Title="密码变量"
                                            Text="{Binding PasswordVariable, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="130" atc:TitleAssist.Title="令牌变量（Bearer）"
                                            Text="{Binding TokenVariable, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="130" atc:TitleAssist.Title="API Key 头"
                                            Text="{Binding ApiKeyHeader, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="130" atc:TitleAssist.Title="API Key 变量"
                                            Text="{Binding ApiKeyVariable, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="130" atc:TitleAssist.Title="证书口令变量"
                                            Text="{Binding CertificatePasswordVariable, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <jv:TextBox atc:TitleAssist.Title="HTTPS 证书（.pfx）"
                                        Text="{Binding CertificatePath, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="业务信封" IsCollapsible="True" IsCollapsed="True" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <jv:CheckBox Content="启用业务信封" IsChecked="{Binding EnvelopeEnabled}" />
                            <WrapPanel>
                                <jv:TextBox Width="90" atc:TitleAssist.Title="码路径"
                                            Text="{Binding CodePath, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="90" atc:TitleAssist.Title="消息路径"
                                            Text="{Binding MessagePath, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="90" atc:TitleAssist.Title="数据路径"
                                            Text="{Binding DataPath, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="130" atc:TitleAssist.Title="成功码（逗号分隔）"
                                            Text="{Binding SuccessCodesText, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="130" atc:TitleAssist.Title="业务失败状态码"
                                            Text="{Binding BusinessFailureStatusCode, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="幂等去重" IsCollapsible="True" IsCollapsed="True" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <jv:CheckBox Content="启用幂等去重" IsChecked="{Binding DeduplicationEnabled}" />
                            <WrapPanel>
                                <jv:TextBox Width="150" atc:TitleAssist.Title="幂等键头"
                                            Text="{Binding DeduplicationHeaderName, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="100" atc:TitleAssist.Title="窗口（毫秒）"
                                            Text="{Binding DeduplicationWindowMs, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="80" atc:TitleAssist.Title="最多条数"
                                            Text="{Binding DeduplicationMaxEntries, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="日志与脱敏" IsCollapsible="True" IsCollapsed="True" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <jv:CheckBox Content="记录正文" IsChecked="{Binding LogBodies}" />
                            <jv:TextBox atc:TitleAssist.Title="脱敏请求头"
                                        Text="{Binding RedactedHeadersText, UpdateSourceTrigger=PropertyChanged}" />
                            <jv:TextBox atc:TitleAssist.Title="脱敏查询参数"
                                        Text="{Binding RedactedQueryParametersText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </jv:GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- 中：路由表。运行中不能修改（库要求启动前注册）；选中一行后可删除。 -->
            <jv:GroupBox Grid.Column="2" Header="路由表（运行中不能修改）">
                <DockPanel>
                    <jv:Button DockPanel.Dock="Bottom" Content="删除选中的路由" Command="{Binding RemoveRouteCommand}"
                               CommandParameter="{Binding SelectedRoute}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    <DataGrid x:Name="RouteGrid" ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                              IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="60" />
                            <DataGridTextColumn Header="模板" Binding="{Binding Template}" Width="*" />
                            <DataGridTextColumn Header="响应" Binding="{Binding KindText}" Width="90" />
                            <DataGridTextColumn Header="状态码" Binding="{Binding StatusCode}" Width="60" />
                            <DataGridTextColumn Header="延迟（毫秒）" Binding="{Binding DelayMs}" Width="80" />
                            <DataGridTextColumn Header="业务码" Binding="{Binding Code}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </jv:GroupBox>

            <!-- 右：服务端状态、实际监听地址与请求日志；底部为操作记录（启动与停止的结果）。 -->
            <DockPanel Grid.Column="4">
                <local:OperationListView DockPanel.Dock="Bottom" Height="130" Margin="0,12,0,0" />
                <jv:GroupBox Header="状态与请求日志">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <jv:Button DockPanel.Dock="Right" Content="清空请求日志" Command="{Binding ClearRequestLogCommand}" Margin="8,0,0,12" />
                            <jv:TextBlock Text="{Binding ServerStateText, StringFormat=服务端状态：{0}}" Style="{StaticResource Text.Section}"
                                          VerticalAlignment="Center" />
                        </DockPanel>
                        <jv:TextBox DockPanel.Dock="Top" atc:TitleAssist.Title="实际监听地址" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                                    IsReadOnly="True" Text="{Binding BoundUrls, Mode=OneWay}" />
                        <DataGrid ItemsSource="{Binding RequestLog}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="90" />
                                <DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="60" />
                                <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" />
                                <DataGridTextColumn Header="路由" Binding="{Binding Route}" Width="*" />
                                <DataGridTextColumn Header="结果" Binding="{Binding Outcome}" Width="80" />
                                <DataGridTextColumn Header="状态码" Binding="{Binding Status}" Width="60" />
                                <DataGridTextColumn Header="耗时" Binding="{Binding Elapsed}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </jv:GroupBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
