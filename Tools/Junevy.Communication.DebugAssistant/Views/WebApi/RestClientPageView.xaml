<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.WebApi.RestClientPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- REST 客户端页（计划第 7.9 节）：左侧为连接、认证、重试、信封与健康检查（运行中不可修改）；右侧上方为请求与响应并排，下方为时间线、操作记录与报文日志。 -->
    <DockPanel Margin="12">
        <local:ConnectionBarView DockPanel.Dock="Top" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Style="{StaticResource Panel.SettingsScroll}">
                <StackPanel>
                    <jv:GroupBox Header="连接" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <jv:TextBox atc:TitleAssist.Title="基地址"
                                        Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <WrapPanel>
                                <jv:TextBox Width="120" atc:TitleAssist.Title="超时（毫秒）"
                                            Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:ComboBox Width="120" atc:TitleAssist.Title="认证"
                                             ItemsSource="{Binding AuthChoices}" SelectedItem="{Binding AuthScheme}" />
                            </WrapPanel>
                            <jv:TextBlock Style="{StaticResource Text.Hint}" Text="认证只填环境变量名，值不保存。" />
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="认证变量" IsCollapsible="True" IsCollapsed="True" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <WrapPanel>
                                <jv:TextBox Width="130" atc:TitleAssist.Title="用户名变量"
                                            Text="{Binding UserNameVariable, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="130" atc:TitleAssist.Title="密码变量"
                                            Text="{Binding PasswordVariable, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="130" atc:TitleAssist.Title="令牌变量（Bearer）"
                                            Text="{Binding TokenVariable, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="130" atc:TitleAssist.Title="API Key 头"
                                            Text="{Binding ApiKeyHeader, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <jv:TextBox Width="130" atc:TitleAssist.Title="API Key 变量"
                                        Text="{Binding ApiKeyVariable, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="重试" IsCollapsible="True" IsCollapsed="True" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <WrapPanel>
                                <jv:TextBox Width="110" atc:TitleAssist.Title="重试次数"
                                            Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="130" atc:TitleAssist.Title="重试间隔（毫秒）"
                                            Text="{Binding RetryDelayMs, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <jv:CheckBox Content="重试不安全的方法" IsChecked="{Binding RetryUnsafeMethods}" />
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="业务信封" IsCollapsible="True" IsCollapsed="True" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <jv:CheckBox Content="业务信封" IsChecked="{Binding EnvelopeEnabled}" />
                            <WrapPanel>
                                <jv:TextBox Width="110" atc:TitleAssist.Title="码路径"
                                            Text="{Binding CodePath, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="消息路径"
                                            Text="{Binding MessagePath, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="110" atc:TitleAssist.Title="数据路径"
                                            Text="{Binding DataPath, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="150" atc:TitleAssist.Title="成功码（逗号分隔）"
                                            Text="{Binding SuccessCodesText, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="健康检查与日志" IsCollapsible="True" IsCollapsed="True" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <jv:TextBox Width="260" atc:TitleAssist.Title="健康检查路径" atc:PlaceholderAssist.Placeholder="留空不检查"
                                        Text="{Binding HealthCheckPath, UpdateSourceTrigger=PropertyChanged}" />
                            <WrapPanel>
                                <jv:TextBox Width="130" atc:TitleAssist.Title="检查间隔（毫秒）"
                                            Text="{Binding HealthCheckIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="离线阈值（次）"
                                            Text="{Binding OfflineThreshold, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <jv:CheckBox Content="记录正文（不建议在生产环境开启）" IsChecked="{Binding LogBodies}" />
                            <jv:TextBox atc:TitleAssist.Title="脱敏请求头"
                                        Text="{Binding RedactedHeadersText, UpdateSourceTrigger=PropertyChanged}" />
                            <jv:TextBox atc:TitleAssist.Title="脱敏查询参数"
                                        Text="{Binding RedactedQueryParametersText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </jv:GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- 中：请求构造与发送。 -->
            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Columns}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="240" MinHeight="120" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <jv:GroupBox Grid.Column="0" Margin="0" Header="请求">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <WrapPanel>
                                    <jv:ComboBox Width="100" atc:TitleAssist.Title="方法"
                                                 ItemsSource="{Binding MethodChoices}" SelectedItem="{Binding Method}" />
                                    <jv:TextBox Width="240" atc:TitleAssist.Title="路径"
                                                Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                                    <jv:Button Content="发送" Command="{Binding SendCommand}" Margin="0,22,0,12" />
                                </WrapPanel>
                                <jv:TextBlock Text="{Binding RequestMessage}" Style="{StaticResource Text.Hint}" />

                                <jv:TextBlock Style="{StaticResource Text.Section}" Text="查询参数" />
                                <WrapPanel>
                                    <jv:TextBox Width="120" atc:TitleAssist.Title="名称"
                                                Text="{Binding QueryName, UpdateSourceTrigger=PropertyChanged}" />
                                    <jv:TextBox Width="130" atc:TitleAssist.Title="值"
                                                Text="{Binding QueryValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <jv:Button Content="添加" Command="{Binding AddQueryCommand}" Margin="0,22,8,12" />
                                    <jv:Button Content="删除选中" Command="{Binding RemoveQueryCommand}" CommandParameter="{Binding SelectedQuery}" Margin="0,22,0,12" />
                                </WrapPanel>
                                <DataGrid ItemsSource="{Binding QueryRows}" SelectedItem="{Binding SelectedQuery, Mode=TwoWay}"
                                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="90">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="查询参数" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <jv:TextBlock Style="{StaticResource Text.Section}" Text="请求头" />
                                <WrapPanel>
                                    <jv:TextBox Width="120" atc:TitleAssist.Title="名称"
                                                Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}" />
                                    <jv:TextBox Width="130" atc:TitleAssist.Title="值"
                                                Text="{Binding HeaderValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <jv:Button Content="添加" Command="{Binding AddHeaderCommand}" Margin="0,22,8,12" />
                                    <jv:Button Content="删除选中" Command="{Binding RemoveHeaderCommand}" CommandParameter="{Binding SelectedHeader}" Margin="0,22,0,12" />
                                </WrapPanel>
                                <DataGrid ItemsSource="{Binding HeaderRows}" SelectedItem="{Binding SelectedHeader, Mode=TwoWay}"
                                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="90">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="请求头" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <jv:TextBlock Style="{StaticResource Text.Section}" Text="正文与选项" />
                                <WrapPanel>
                                    <jv:TextBox Width="150" atc:TitleAssist.Title="内容类型"
                                                Text="{Binding ContentType, UpdateSourceTrigger=PropertyChanged}" />
                                    <jv:TextBox Width="150" atc:TitleAssist.Title="幂等键"
                                                Text="{Binding IdempotencyKey, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                                <jv:CheckBox Content="以文本显示响应" IsChecked="{Binding ResponseAsText}" />
                                <jv:TextBlock Text="正文（JSON；空表示没有正文）" Style="{StaticResource Text.Hint}" />
                                <jv:CodeEditor Text="{Binding BodyText, Mode=TwoWay}" SyntaxLanguage="Json" Height="200" />
                            </StackPanel>
                        </ScrollViewer>
                    </jv:GroupBox>

                    <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Columns}" />

                    <!-- 响应：状态在上，正文占满剩余高度 -->
                    <jv:GroupBox Grid.Column="2" Header="响应" Margin="0">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top">
                                <jv:TextBlock Text="{Binding AvailabilityText, StringFormat=可用性：{0}}" Style="{StaticResource Text.Section}" Margin="0,0,16,8" />
                                <jv:TextBlock Text="{Binding ResponseStatus, StringFormat=HTTP 状态：{0}}" Margin="0,4,16,8" />
                                <jv:TextBlock Text="{Binding ResponseRemoteCode, StringFormat=业务码：{0}}" Margin="0,4,16,8" />
                                <jv:TextBlock Text="{Binding ResponseErrorKind, StringFormat=结果：{0}}" Margin="0,4,0,8" />
                            </WrapPanel>
                            <jv:TextBlock DockPanel.Dock="Top" Text="{Binding ResponseMessage}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" />
                            <jv:TextBlock DockPanel.Dock="Top" Text="响应数据" Style="{StaticResource Text.Hint}" />
                            <jv:CodeEditor Text="{Binding ResponseData, Mode=OneWay}" SyntaxLanguage="Json" IsReadOnly="True" MinHeight="80" />
                        </DockPanel>
                    </jv:GroupBox>
                </Grid>

                <GridSplitter Grid.Row="1" Style="{StaticResource Splitter.Rows}" />

                <TabControl Grid.Row="2">
                    <TabItem Header="时间线">
                        <DockPanel Margin="8">
                            <jv:Button DockPanel.Dock="Top" Content="清空时间线" Command="{Binding ClearTimelineCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding Timeline}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="90" />
                                    <DataGridTextColumn Header="事件" Binding="{Binding Event}" Width="80" />
                                    <DataGridTextColumn Header="尝试" Binding="{Binding Attempt}" Width="50" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="60" />
                                    <DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="*" MinWidth="200" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="操作记录">
                        <local:OperationListView Margin="8" />
                    </TabItem>
                    <TabItem Header="报文与日志">
                        <sessions:LogPanel DataContext="{Binding LogPanel}" Margin="8" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
