<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.WebApi.RestClientPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- REST 客户端页（计划第 7.9 节）：连接选项、请求构造、响应、事件时间线与可用性；公共面板。 -->
    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:ConnectionBarView Grid.Row="0" Margin="0,0,0,6" />

            <!-- 连接选项：运行中不可修改（客户端在创建时取快照）。认证只填环境变量名，值不保存。 -->
            <jv:GroupBox Grid.Row="1" Header="连接选项（认证只填环境变量名）" Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <StackPanel>
                    <WrapPanel>
                        <Label Content="基地址" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,12,0" />
                        <Label Content="超时（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="认证" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding AuthChoices}" SelectedItem="{Binding AuthScheme}" Width="100" Margin="0,0,12,0" />
                        <Label Content="用户名变量" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding UserNameVariable, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,12,0" />
                        <Label Content="密码变量" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding PasswordVariable, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="令牌变量（Bearer）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding TokenVariable, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,12,0" />
                        <Label Content="API Key 头" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ApiKeyHeader, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,12,0" />
                        <Label Content="API Key 变量" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ApiKeyVariable, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,12,0" />
                        <Label Content="重试次数" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0" />
                        <Label Content="重试间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding RetryDelayMs, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <CheckBox Content="重试不安全的方法" IsChecked="{Binding RetryUnsafeMethods}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox Content="业务信封" IsChecked="{Binding EnvelopeEnabled}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Label Content="码路径" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding CodePath, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,12,0" />
                        <Label Content="消息路径" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MessagePath, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,12,0" />
                        <Label Content="数据路径" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding DataPath, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,12,0" />
                        <Label Content="成功码（逗号分隔）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding SuccessCodesText, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="健康检查路径（留空不检查）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding HealthCheckPath, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,12,0" />
                        <Label Content="检查间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding HealthCheckIntervalMs, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="离线阈值（次）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding OfflineThreshold, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0" />
                        <CheckBox Content="记录正文（不建议在生产环境开启）" IsChecked="{Binding LogBodies}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="脱敏请求头" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding RedactedHeadersText, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,12,0" />
                        <Label Content="脱敏查询参数" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding RedactedQueryParametersText, UpdateSourceTrigger=PropertyChanged}" Width="260" />
                    </WrapPanel>
                </StackPanel>
            </jv:GroupBox>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：请求构造与发送。 -->
                <jv:GroupBox Grid.Column="0" Header="请求" Margin="0,0,6,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <ComboBox ItemsSource="{Binding MethodChoices}" SelectedItem="{Binding Method}" Width="90" Margin="0,0,6,0" />
                            <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,6,0" />
                            <jv:Button Content="发送" Command="{Binding SendCommand}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding RequestMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                            <TextBox Text="{Binding QueryName, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,6,0" />
                            <TextBox Text="{Binding QueryValue, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,6,0" />
                            <jv:Button Content="添加查询参数" Command="{Binding AddQueryCommand}" Margin="0,0,6,0" />
                            <jv:Button Content="删除选中" Command="{Binding RemoveQueryCommand}" CommandParameter="{Binding SelectedQuery}" />
                        </WrapPanel>
                        <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding QueryRows}" SelectedItem="{Binding SelectedQuery, Mode=TwoWay}"
                                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="90" Margin="0,4,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="查询参数" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                            <TextBox Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,6,0" />
                            <TextBox Text="{Binding HeaderValue, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,6,0" />
                            <jv:Button Content="添加请求头" Command="{Binding AddHeaderCommand}" Margin="0,0,6,0" />
                            <jv:Button Content="删除选中" Command="{Binding RemoveHeaderCommand}" CommandParameter="{Binding SelectedHeader}" />
                        </WrapPanel>
                        <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding HeaderRows}" SelectedItem="{Binding SelectedHeader, Mode=TwoWay}"
                                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="90" Margin="0,4,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="请求头" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                            <Label Content="内容类型" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding ContentType, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,12,0" />
                            <Label Content="幂等键" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding IdempotencyKey, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,12,0" />
                            <CheckBox Content="以文本显示响应" IsChecked="{Binding ResponseAsText}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="正文（JSON；空表示没有正文）" Margin="0,4,0,0" />
                        <jv:CodeEditor Text="{Binding BodyText, Mode=TwoWay}" SyntaxLanguage="Json" Height="120" />
                    </DockPanel>
                </jv:GroupBox>

                <!-- 右：响应、可用性与事件时间线。 -->
                <jv:GroupBox Grid.Column="1" Header="响应与时间线" Margin="6,0,0,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding AvailabilityText, StringFormat=可用性：{0}}" FontWeight="SemiBold" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding ResponseStatus, StringFormat=HTTP 状态：{0}}" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding ResponseRemoteCode, StringFormat=业务码：{0}}" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding ResponseErrorKind, StringFormat=结果：{0}}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ResponseMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock DockPanel.Dock="Top" Text="响应数据" Margin="0,4,0,0" />
                        <jv:CodeEditor Text="{Binding ResponseData, Mode=OneWay}" SyntaxLanguage="Json" IsReadOnly="True" Height="140" />
                        <jv:Button DockPanel.Dock="Top" Content="清空时间线" Command="{Binding ClearTimelineCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        <DataGrid ItemsSource="{Binding Timeline}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,4,0,0"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="90" />
                                <DataGridTextColumn Header="事件" Binding="{Binding Event}" Width="70" />
                                <DataGridTextColumn Header="尝试" Binding="{Binding Attempt}" Width="50" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="60" />
                                <DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </jv:GroupBox>
            </Grid>

            <!-- 操作记录：每次请求的结果与错误种类 -->
            <Border Grid.Row="3" Margin="0,6,0,0" Height="160">
                <local:OperationListView />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
