<Window x:Class="Junevy.Communication.DebugAssistant.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:jv="github.com.junevy"
        Title="Junevy 通讯调试助手"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        Background="{DynamicResource Theme.Brush.Background.App}"
        TextElement.Foreground="{DynamicResource Theme.Brush.Text.Primary}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <jv:Button Content="切换主题" Command="{Binding ToggleThemeCommand}" />
        </StackPanel>
        <jv:TextBlock Text="双击左侧协议，打开一个调试页" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </DockPanel>
</Window>
