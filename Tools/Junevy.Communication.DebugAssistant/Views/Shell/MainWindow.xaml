<Window x:Class="Junevy.Communication.DebugAssistant.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:jv="github.com.junevy"
        xmlns:behaviors="clr-namespace:Junevy.Communication.DebugAssistant.Views.Behaviors"
        Title="Junevy 通讯调试助手"
        Width="1280" Height="800" MinWidth="960" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Brush.Background.App}"
        TextElement.Foreground="{DynamicResource Theme.Brush.Text.Primary}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Theme.Brush.Border.Divider}">
            <StackPanel Orientation="Horizontal">
                <jv:Button Content="保存工作区" Command="{Binding SaveWorkspaceCommand}" Margin="0,0,8,0" />
                <jv:Button Content="导入页签" Command="{Binding ImportSessionCommand}" Margin="0,0,8,0" />
                <jv:Button Content="导出当前页签" Command="{Binding ExportSessionCommand}" Margin="0,0,8,0" />
                <jv:Button Content="关闭全部页签" Command="{Binding CloseAllSessionsCommand}" Margin="0,0,8,0" />
                <jv:Button Content="切换主题" Command="{Binding ToggleThemeCommand}" />
            </StackPanel>
        </Border>

        <jv:MessageBarPresenter x:Name="NotificationPresenter" DockPanel.Dock="Bottom" Margin="16,0,16,8" />

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="600" />
            </Grid.ColumnDefinitions>

            <jv:TreeView x:Name="ProtocolTree" Grid.Column="0" ItemsSource="{Binding Tree}" DisplayMode="Chevron">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="ItemDoubleClick">
                        <i:InvokeCommandAction Command="{Binding OpenSessionCommand}" EventArgsParameterPath="Item" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </jv:TreeView>

            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Columns}" />

            <Grid Grid.Column="2">
                <jv:TabControl x:Name="SessionTabs"
                               ItemsSource="{Binding Sessions}"
                               SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                               CanRename="True">
                    <jv:TabControl.ItemContainerStyle>
                        <Style TargetType="{x:Type jv:TabControlItem}" BasedOn="{StaticResource DefaultTabControlItemStyle}">
                            <Setter Property="Header" Value="{Binding Title, Mode=TwoWay}" />
                        </Style>
                    </jv:TabControl.ItemContainerStyle>
                    <i:Interaction.Behaviors>
                        <behaviors:CloseTabToCommandBehavior Command="{Binding CloseSessionCommand}" />
                    </i:Interaction.Behaviors>
                </jv:TabControl>

                <jv:TextBlock Text="双击左侧协议，打开一个调试页" HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsHitTestVisible="False">
                    <jv:TextBlock.Style>
                        <Style TargetType="{x:Type jv:TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSessions}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </jv:TextBlock.Style>
                </jv:TextBlock>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
