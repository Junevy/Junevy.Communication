<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Siemens.S7PageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:siemens="clr-namespace:Junevy.Communication.DebugAssistant.Protocols.Siemens"
             xmlns:s7="clr-namespace:Junevy.Communication.Siemens;assembly=Junevy.Communication.Siemens"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:plcViews="clr-namespace:Junevy.Communication.DebugAssistant.Views.Plc"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- S7 页签（计划第 7.4 节）：左侧为连接与 TSAP、通道参数、字符串面板与帮助；右侧上方为公共面板，下方为监控表、操作记录与报文日志。 -->
    <UserControl.Resources>
        <ObjectDataProvider x:Key="ConnectionTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="s7:S7ConnectionType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="StringKinds" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="siemens:S7StringKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <local:ConnectionBarView DockPanel.Dock="Top" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Style="{StaticResource Panel.SettingsScroll}">
                <StackPanel>
                    <jv:GroupBox Header="连接参数（ISO-on-TCP）" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <WrapPanel>
                                <jv:TextBox Width="200" atc:TitleAssist.Title="主机"
                                            Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="端口"
                                            Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="90" atc:TitleAssist.Title="机架"
                                            Text="{Binding Rack, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="90" atc:TitleAssist.Title="槽号"
                                            Text="{Binding Slot, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:ComboBox Width="130" atc:TitleAssist.Title="连接类型"
                                             ItemsSource="{Binding Source={StaticResource ConnectionTypes}}" SelectedItem="{Binding ConnectionType}" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal">
                                <jv:TextBlock Style="{StaticResource Text.Hint}" Text="远端 TSAP" Margin="0,0,8,12" />
                                <jv:TextBlock Text="{Binding RemoteTsapText}" FontWeight="SemiBold" Margin="0,0,0,12" />
                            </StackPanel>
                            <jv:TextBlock Style="{StaticResource Text.Hint}" Text="{Binding PduText}" />
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="通道参数（超时、心跳、重连、TLS）" IsCollapsible="True" IsCollapsed="True"
                                 IsEnabled="{Binding IsEditable}">
                        <local:ChannelSettingsView DataContext="{Binding Channel}" />
                    </jv:GroupBox>

                    <!-- 字符串读写不受连接状态限制，因此这里不绑定 IsEditable -->
                    <jv:GroupBox Header="字符串（String 与 WString，带长度头部）">
                        <StackPanel>
                            <WrapPanel>
                                <jv:TextBox Width="120" atc:TitleAssist.Title="地址"
                                            Text="{Binding StringAddress, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:ComboBox Width="110" atc:TitleAssist.Title="类型"
                                             ItemsSource="{Binding Source={StaticResource StringKinds}}" SelectedItem="{Binding StringKind}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="最大长度"
                                            Text="{Binding StringMaxLength, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="240" atc:TitleAssist.Title="值"
                                            Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:Button Content="读取字符串" Command="{Binding ReadStringCommand}" Margin="0,22,8,12" />
                                <jv:Button Content="写入字符串" Command="{Binding WriteStringCommand}" Margin="0,22,0,12" />
                            </WrapPanel>
                            <jv:TextBlock Style="{StaticResource Text.Hint}" Text="{Binding StringHeaderText}" />
                            <jv:TextBlock Style="{StaticResource Text.Hint}"
                                          Text="String 的最大长度为 1 到 254，WString 为 1 到 16382；超出范围的长度被拒绝，且不发送报文。" />
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="帮助：PLC 端设置、地址与单包上限" IsCollapsible="True" IsCollapsed="True">
                        <StackPanel>
                            <jv:TextBlock Style="{StaticResource Text.Hint}"
                                          Text="PLC 端需要三项设置：1. 允许 PUT/GET 访问（CPU 保护设置）；2. 数据块取消“优化块访问”，否则绝对地址如 DB1.DBW12 不存在；3. 在 CPU 与防火墙上开放 102 端口。0x8104 与数据项返回码 0x03、0x05、0x0A 会附带这些提示。" />
                            <jv:TextBlock Style="{StaticResource Text.Hint}"
                                          Text="地址写法：DB1.DBX12.3、DB1.DBB12、DB1.DBW12、DB1.DBD12，M、I、Q 同样（M12.3、MB12、MW12、MD12），可带 % 前缀。X 宽度字母只用于数据块，MX0.0 这类写法会被拒绝，应写 M0.0。" />
                            <jv:TextBlock Style="{StaticResource Text.Hint}"
                                          Text="单包上限：PDU 240 时读 222 字节、写 212 字节；PDU 960 时读 942 字节、写 932 字节。字节精确读取用公共面板的“字节”类型，例如读 MB0 起的 16 字节。" />
                            <jv:TextBlock Style="{StaticResource Text.Hint}"
                                          Text="错误分类：头部错误（类与码）与数据项返回码分别写在操作记录的消息与协议码中。" />
                        </StackPanel>
                    </jv:GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Columns}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="260" MinHeight="120" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Style="{StaticResource Panel.SettingsScroll}">
                    <StackPanel>
                        <plcViews:PlcPanelView />
                    </StackPanel>
                </ScrollViewer>

                <GridSplitter Grid.Row="1" Style="{StaticResource Splitter.Rows}" />

                <TabControl Grid.Row="2">
                    <TabItem Header="监控表">
                        <plcViews:PlcMonitorView Margin="8" />
                    </TabItem>
                    <TabItem Header="操作记录">
                        <local:OperationListView Margin="8" />
                    </TabItem>
                    <TabItem Header="报文与日志">
                        <sessions:LogPanel DataContext="{Binding LogPanel}" Margin="8" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
