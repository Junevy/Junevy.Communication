<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Siemens.S7PageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:siemens="clr-namespace:Junevy.Communication.DebugAssistant.Protocols.Siemens"
             xmlns:s7="clr-namespace:Junevy.Communication.Siemens;assembly=Junevy.Communication.Siemens"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:plcViews="clr-namespace:Junevy.Communication.DebugAssistant.Views.Plc"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- S7 页签（计划第 7.4 节）：机架、槽号与连接类型（远端 TSAP）、协商的 PDU 与单包上限；String 与 WString 面板；公共面板。 -->
    <UserControl.Resources>
        <ObjectDataProvider x:Key="ConnectionTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="s7:S7ConnectionType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="StringKinds" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="siemens:S7StringKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 连接参数与 TSAP、PDU -->
            <jv:GroupBox Grid.Row="0" Header="连接参数（ISO-on-TCP）" Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <StackPanel>
                    <WrapPanel>
                        <Label Content="主机" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,12,0" />
                        <Label Content="端口" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                        <Label Content="机架" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Rack, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,12,0" />
                        <Label Content="槽号" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Slot, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,12,0" />
                        <Label Content="连接类型" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource ConnectionTypes}}" SelectedItem="{Binding ConnectionType}" Width="90" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="远端 TSAP" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding RemoteTsapText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Text="{Binding PduText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />
                </StackPanel>
            </jv:GroupBox>

            <local:ConnectionBarView Grid.Row="1" Margin="0,0,0,6" />

            <jv:GroupBox Grid.Row="2" Header="通道参数（超时、心跳、重连、套接字与 TLS）" IsCollapsible="True" IsCollapsed="True" Margin="0,0,0,6"
                         IsEnabled="{Binding IsEditable}">
                <local:ChannelSettingsView DataContext="{Binding Channel}" MaxHeight="360" />
            </jv:GroupBox>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- 左：公共面板 -->
                <plcViews:PlcPanelView Grid.Column="0" Margin="0,0,8,0" />

                <!-- 右：字符串面板与帮助 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 字符串读写不受连接状态限制，因此这里不绑定 IsEditable -->
                        <jv:GroupBox Header="字符串（String 与 WString，带长度头部）" Margin="0,0,0,8">
                            <StackPanel>
                                <WrapPanel>
                                    <Label Content="地址" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding StringAddress, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,12,0" />
                                    <Label Content="类型" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding Source={StaticResource StringKinds}}" SelectedItem="{Binding StringKind}" Width="90" Margin="0,0,12,0" />
                                    <Label Content="最大长度" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding StringMaxLength, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <Label Content="值" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,12,0" />
                                    <jv:Button Content="读取字符串" Command="{Binding ReadStringCommand}" Margin="0,0,6,0" />
                                    <jv:Button Content="写入字符串" Command="{Binding WriteStringCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding StringHeaderText}" Margin="0,4,0,0" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />
                                <TextBlock Text="String 的最大长度为 1 到 254，WString 为 1 到 16382；超出范围的长度被拒绝，且不发送报文。"
                                           TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />
                            </StackPanel>
                        </jv:GroupBox>

                        <jv:GroupBox Header="帮助：PLC 端设置、地址与单包上限" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Text="PLC 端需要三项设置：1. 允许 PUT/GET 访问（CPU 保护设置）；2. 数据块取消“优化块访问”，否则绝对地址如 DB1.DBW12 不存在；3. 在 CPU 与防火墙上开放 102 端口。0x8104 与数据项返回码 0x03、0x05、0x0A 会附带这些提示。" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="地址写法：DB1.DBX12.3、DB1.DBB12、DB1.DBW12、DB1.DBD12，M、I、Q 同样（M12.3、MB12、MW12、MD12），可带 % 前缀。X 宽度字母只用于数据块，MX0.0 这类写法会被拒绝，应写 M0.0。" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="单包上限：PDU 240 时读 222 字节、写 212 字节；PDU 960 时读 942 字节、写 932 字节。字节精确读取用公共面板的“字节”类型，例如读 MB0 起的 16 字节。" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="错误分类：头部错误（类与码）与数据项返回码分别写在操作记录的消息与协议码中。" />
                            </StackPanel>
                        </jv:GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 操作记录 -->
            <Border Grid.Row="4" Margin="0,6,0,0" Height="160">
                <local:OperationListView />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
