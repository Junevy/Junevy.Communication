<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.OpcUa.OpcUaPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:opcua="clr-namespace:Junevy.Communication.DebugAssistant.Protocols.OpcUa"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- OPC UA 客户端页（计划第 7.8 节）：连接选项（只支持 None 与匿名）、懒加载浏览、读写列表（逐项结果、显式类型写入）、订阅与实时通知。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:ConnectionBarView Grid.Row="0" Margin="0,0,0,6" />

            <!-- 连接选项：运行中不可修改（库在创建时取快照）。 -->
            <jv:GroupBox Grid.Row="1" Header="连接选项" Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <StackPanel>
                    <TextBlock Text="安全提示：本页只支持 None 安全策略与匿名登录。服务器必须允许这种方式，否则连接会返回 NotSupported。"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <WrapPanel>
                        <Label Content="端点地址" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding EndpointUrl, UpdateSourceTrigger=PropertyChanged}" Width="230" Margin="0,0,12,0" />
                        <Label Content="应用名" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ApplicationName, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,12,0" />
                        <Label Content="应用 URI（留空自动生成）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ApplicationUri, UpdateSourceTrigger=PropertyChanged}" Width="170" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="证书目录" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding PkiRoot, UpdateSourceTrigger=PropertyChanged}" Width="330" Margin="0,0,12,0" />
                        <Label Content="连接超时（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ConnectTimeout, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="操作超时（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding OperationTimeout, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="会话超时（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding SessionTimeout, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="保活间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding KeepAliveInterval, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="重连间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ReconnectInterval, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="最大重连间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MaxReconnectInterval, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </WrapPanel>
                </StackPanel>
            </jv:GroupBox>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：懒加载浏览。展开对象节点才浏览子节点；双击变量加入读写列表。 -->
                <jv:GroupBox Grid.Column="0" Header="浏览（从 i=85 开始，双击变量加入读写列表）" Margin="0,0,6,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <jv:Button Content="浏览 i=85" Command="{Binding BrowseRootCommand}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding BrowseMessage}" TextWrapping="Wrap" Margin="0,4,0,4" />
                        <TreeView ItemsSource="{Binding BrowseRoots}">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <EventSetter Event="MouseDoubleClick" Handler="OnBrowseItemDoubleClick" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type opcua:OpcUaNodeItem}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding BrowseName, StringFormat=浏览名：{0}}">
                                        <TextBlock Text="{Binding DisplayName}" />
                                        <TextBlock Text="{Binding NodeId, StringFormat=' ({0})'}" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />
                                        <TextBlock Text="{Binding NodeClass, StringFormat=' [{0}]'}" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </jv:GroupBox>

                <!-- 中：读写列表。批量读的每一项有自己的值、类型、状态与时间戳；写入区按所选 .NET 类型写入，不做转换。 -->
                <jv:GroupBox Grid.Column="1" Header="读写列表" Margin="6,0,6,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <TextBox Text="{Binding NewNodeId, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,6,0" />
                            <jv:Button Content="添加节点" Command="{Binding AddNodeCommand}" Margin="0,0,12,0" />
                            <jv:Button Content="读取全部" Command="{Binding ReadCommand}" Margin="0,0,6,0" />
                            <jv:Button Content="写入有值的行" Command="{Binding WriteCommand}" Margin="0,0,6,0" />
                            <jv:Button Content="删除选中行" Command="{Binding RemoveNodeCommand}" CommandParameter="{Binding SelectedItem}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="推荐 nsu=urn:...;s=... 写法；ns= 形式在服务器重启后可能指向别的变量。" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ListMessage}" TextWrapping="Wrap" Margin="0,4,0,4" />

                        <!-- 选中行的写入区：类型、数组、值；每行一个数组元素，字节用十六进制（如 hex: 01 FF）。 -->
                        <Border DockPanel.Dock="Bottom" BorderThickness="1" Padding="6" Margin="0,6,0,0"
                                BorderBrush="{DynamicResource Theme.Brush.Border.Default}">
                            <StackPanel>
                                <TextBlock Text="写入（选中行）" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,4,0,0">
                                    <Label Content="类型" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding WriteTypeChoices}" SelectedItem="{Binding SelectedItem.WriteType}" Width="230" Margin="0,0,12,0" />
                                    <CheckBox Content="一维数组（每行一个元素）" IsChecked="{Binding SelectedItem.IsArray}" VerticalAlignment="Center" />
                                </WrapPanel>
                                <TextBox Text="{Binding SelectedItem.WriteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding SelectedItem.WriteStatus}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,4,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NodeId" Binding="{Binding NodeId}" Width="*" />
                                <DataGridTextColumn Header="写法提示" Binding="{Binding Hint}" Width="*" />
                                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                                <DataGridTextColumn Header=".NET 类型" Binding="{Binding DotNetType}" Width="90" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" />
                                <DataGridTextColumn Header="源时间戳" Binding="{Binding SourceTimestamp}" Width="130" />
                                <DataGridTextColumn Header="服务器时间戳" Binding="{Binding ServerTimestamp}" Width="130" />
                                <DataGridTextColumn Header="写入结果" Binding="{Binding WriteStatus}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </jv:GroupBox>

                <!-- 右：订阅的创建与释放、逐项状态与实时通知。 -->
                <jv:GroupBox Grid.Column="2" Header="订阅" Margin="6,0,0,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <Label Content="发布间隔（毫秒）" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding PublishingInterval, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                            <Label Content="采样间隔（毫秒，空为跟随）" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding SamplingInterval, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                            <Label Content="队列长度" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding QueueSize, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,12,0" />
                            <CheckBox Content="队列满时丢弃最旧的" IsChecked="{Binding DiscardOldest}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                            <jv:Button Content="订阅读写列表中的节点" Command="{Binding SubscribeCommand}" Margin="0,0,6,0" />
                            <jv:Button Content="释放订阅" Command="{Binding ReleaseSubscriptionCommand}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SubscriptionMessage}" TextWrapping="Wrap" Margin="0,4,0,4" />
                        <DataGrid ItemsSource="{Binding SubscribedItems}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NodeId" Binding="{Binding NodeId}" Width="*" />
                                <DataGridTextColumn Header="创建状态" Binding="{Binding Status}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock DockPanel.Dock="Top" Text="实时通知（最新在前）" Margin="0,6,0,2" />
                        <DataGrid ItemsSource="{Binding Notifications}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="接收时间" Binding="{Binding Time}" Width="90" />
                                <DataGridTextColumn Header="NodeId" Binding="{Binding NodeId}" Width="*" />
                                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </jv:GroupBox>
            </Grid>

            <!-- 操作记录：连接、浏览、读写、订阅的结果与错误种类 -->
            <Border Grid.Row="3" Margin="0,6,0,0" Height="160">
                <local:OperationListView />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
