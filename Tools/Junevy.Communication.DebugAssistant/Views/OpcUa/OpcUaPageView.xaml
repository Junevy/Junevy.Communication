<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.OpcUa.OpcUaPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
             xmlns:opcua="clr-namespace:Junevy.Communication.DebugAssistant.Protocols.OpcUa"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- OPC UA 客户端页（计划第 7.8 节）：左侧为连接选项与懒加载浏览；中间为读写列表与选中行的写入；右侧为订阅与实时通知，底部为操作记录。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <DockPanel Margin="12">
        <jv:ExpanderPanel DockPanel.Dock="Bottom" DisplayMode="Card" Header="报文与日志" IsExpanded="False" Margin="0,12,0,0">
            <sessions:LogPanel DataContext="{Binding LogPanel}" Height="200" />
        </jv:ExpanderPanel>

        <local:ConnectionBarView DockPanel.Dock="Top" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：连接选项（只支持 None 与匿名）与懒加载浏览。展开对象节点才浏览子节点；双击变量加入读写列表。 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <jv:GroupBox Header="连接选项" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <jv:TextBlock Text="安全提示：本页只支持 None 安全策略与匿名登录。服务器必须允许这种方式，否则连接会返回 NotSupported。"
                                          FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <jv:TextBox atc:TitleAssist.Title="端点地址"
                                        Text="{Binding EndpointUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <jv:TextBox atc:TitleAssist.Title="应用名"
                                        Text="{Binding ApplicationName, UpdateSourceTrigger=PropertyChanged}" />
                            <jv:TextBox atc:TitleAssist.Title="应用 URI" atc:PlaceholderAssist.Placeholder="留空自动生成"
                                        Text="{Binding ApplicationUri, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="高级：证书、超时与重连" IsCollapsible="True" IsCollapsed="True" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <jv:TextBox atc:TitleAssist.Title="证书目录"
                                        Text="{Binding PkiRoot, UpdateSourceTrigger=PropertyChanged}" />
                            <WrapPanel>
                                <jv:TextBox Width="110" atc:TitleAssist.Title="连接超时（毫秒）"
                                            Text="{Binding ConnectTimeout, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="操作超时（毫秒）"
                                            Text="{Binding OperationTimeout, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="会话超时（毫秒）"
                                            Text="{Binding SessionTimeout, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="110" atc:TitleAssist.Title="保活间隔（毫秒）"
                                            Text="{Binding KeepAliveInterval, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="重连间隔（毫秒）"
                                            Text="{Binding ReconnectInterval, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="130" atc:TitleAssist.Title="最大重连间隔（毫秒）"
                                            Text="{Binding MaxReconnectInterval, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="浏览（从 i=85 开始，双击变量加入读写列表）">
                        <StackPanel>
                            <jv:Button Content="浏览 i=85" Command="{Binding BrowseRootCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                            <jv:TextBlock Text="{Binding BrowseMessage}" Style="{StaticResource Text.Hint}" />
                            <!-- 节点树使用 WPF 的 TreeView：节点是 OpcUaNodeItem，库的 jv:TreeView 只接受 TreeMenuItem。 -->
                            <TreeView ItemsSource="{Binding BrowseRoots}" MaxHeight="320">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        <EventSetter Event="MouseDoubleClick" Handler="OnBrowseItemDoubleClick" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type opcua:OpcUaNodeItem}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding BrowseName, StringFormat=浏览名：{0}}">
                                            <jv:TextBlock Text="{Binding DisplayName}" />
                                            <jv:TextBlock Text="{Binding NodeId, StringFormat=' ({0})'}" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />
                                            <jv:TextBlock Text="{Binding NodeClass, StringFormat=' [{0}]'}" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </StackPanel>
                    </jv:GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- 中：读写列表。批量读的每一项有自己的值、类型、状态与时间戳；写入区按所选 .NET 类型写入，不做转换。 -->
            <jv:GroupBox Grid.Column="2" Header="读写列表">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top">
                        <jv:TextBox Width="260" atc:TitleAssist.Title="NodeId"
                                    Text="{Binding NewNodeId, UpdateSourceTrigger=PropertyChanged}" />
                        <jv:Button Content="添加节点" Command="{Binding AddNodeCommand}" Margin="0,22,8,12" />
                        <jv:Button Content="读取全部" Command="{Binding ReadCommand}" Margin="0,22,8,12" />
                        <jv:Button Content="写入有值的行" Command="{Binding WriteCommand}" Margin="0,22,8,12" />
                        <jv:Button Content="删除选中行" Command="{Binding RemoveNodeCommand}" CommandParameter="{Binding SelectedItem}" Margin="0,22,0,12" />
                    </WrapPanel>
                    <jv:TextBlock DockPanel.Dock="Top" Text="推荐 nsu=urn:...;s=... 写法；ns= 形式在服务器重启后可能指向别的变量。" Style="{StaticResource Text.Hint}" />
                    <jv:TextBlock DockPanel.Dock="Top" Text="{Binding ListMessage}" Style="{StaticResource Text.Hint}" />

                    <!-- 选中行的写入区：类型、数组、值；每行一个数组元素，字节用十六进制（如 hex: 01 FF）。 -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel.Card}" Margin="0,8,0,0">
                        <StackPanel>
                            <jv:TextBlock Style="{StaticResource Text.Section}" Text="写入（选中行）" />
                            <WrapPanel>
                                <jv:ComboBox Width="230" atc:TitleAssist.Title="类型"
                                             ItemsSource="{Binding WriteTypeChoices}" SelectedItem="{Binding SelectedItem.WriteType}" />
                                <jv:CheckBox Content="一维数组（每行一个元素）" IsChecked="{Binding SelectedItem.IsArray}" Margin="0,22,0,12" />
                            </WrapPanel>
                            <jv:TextBox Text="{Binding SelectedItem.WriteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60"
                                        TextWrapping="Wrap" atc:TitleAssist.Title="值" Margin="0,0,0,12" />
                            <jv:TextBlock Text="{Binding SelectedItem.WriteStatus}" Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NodeId" Binding="{Binding NodeId}" Width="*" />
                            <DataGridTextColumn Header="写法提示" Binding="{Binding Hint}" Width="*" />
                            <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                            <DataGridTextColumn Header=".NET 类型" Binding="{Binding DotNetType}" Width="90" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" />
                            <DataGridTextColumn Header="源时间戳" Binding="{Binding SourceTimestamp}" Width="130" />
                            <DataGridTextColumn Header="服务器时间戳" Binding="{Binding ServerTimestamp}" Width="130" />
                            <DataGridTextColumn Header="写入结果" Binding="{Binding WriteStatus}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </jv:GroupBox>

            <!-- 右：订阅的创建与释放、逐项状态与实时通知；底部为操作记录。 -->
            <DockPanel Grid.Column="4">
                <local:OperationListView DockPanel.Dock="Bottom" Height="130" Margin="0,12,0,0" />
                <jv:GroupBox Header="订阅" Margin="0,0,12,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <jv:TextBox Width="120" atc:TitleAssist.Title="发布间隔（毫秒）"
                                        Text="{Binding PublishingInterval, UpdateSourceTrigger=PropertyChanged}" />
                            <jv:TextBox Width="100" atc:TitleAssist.Title="队列长度"
                                        Text="{Binding QueueSize, UpdateSourceTrigger=PropertyChanged}" />
                            <jv:TextBox Width="200" atc:TitleAssist.Title="采样间隔（毫秒，空为跟随）"
                                        Text="{Binding SamplingInterval, UpdateSourceTrigger=PropertyChanged}" />
                            <jv:CheckBox Content="队列满时丢弃最旧的" IsChecked="{Binding DiscardOldest}" Margin="0,22,0,12" />
                        </WrapPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <jv:Button Content="订阅读写列表中的节点" Command="{Binding SubscribeCommand}" Margin="0,0,8,12" />
                            <jv:Button Content="释放订阅" Command="{Binding ReleaseSubscriptionCommand}" Margin="0,0,0,12" />
                        </WrapPanel>
                        <jv:TextBlock DockPanel.Dock="Top" Text="{Binding SubscriptionMessage}" Style="{StaticResource Text.Hint}" />
                        <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding SubscribedItems}" IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" MaxHeight="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NodeId" Binding="{Binding NodeId}" Width="*" />
                                <DataGridTextColumn Header="创建状态" Binding="{Binding Status}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <jv:TextBlock DockPanel.Dock="Top" Text="实时通知（最新在前）" Style="{StaticResource Text.Section}" />
                        <DataGrid ItemsSource="{Binding Notifications}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="接收时间" Binding="{Binding Time}" Width="90" />
                                <DataGridTextColumn Header="NodeId" Binding="{Binding NodeId}" Width="*" />
                                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </jv:GroupBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
