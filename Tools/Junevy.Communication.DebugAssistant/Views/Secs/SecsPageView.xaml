<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Secs.SecsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:hsms="clr-namespace:Junevy.Communication.Secs.Hsms;assembly=Junevy.Communication.Secs"
             xmlns:secs="clr-namespace:Junevy.Communication.DebugAssistant.Protocols.Secs"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- SECS/HSMS 设备端页（计划第 7.6 节）：左侧为连接、计时器与发送主消息；右侧上方为自动应答规则，下方为收到的主消息、操作记录与报文日志。 -->
    <UserControl.Resources>
        <ObjectDataProvider x:Key="ModeChoices" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="hsms:HsmsConnectionMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="RuleKindChoices" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="secs:SecsRuleKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <local:ConnectionBarView DockPanel.Dock="Top" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- 左：连接与计时器（运行中不可修改，库在启动时取快照），以及发送主消息。 -->
            <ScrollViewer Grid.Column="0" Style="{StaticResource Panel.SettingsScroll}">
                <StackPanel>
                    <jv:GroupBox Header="连接" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <WrapPanel>
                                <jv:ComboBox Width="120" atc:TitleAssist.Title="模式"
                                             ItemsSource="{Binding Source={StaticResource ModeChoices}}" SelectedItem="{Binding Mode}" />
                                <jv:TextBox Width="200" atc:TitleAssist.Title="地址"
                                            Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="端口"
                                            Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="设备号"
                                            Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <jv:TextBlock Style="{StaticResource Text.Hint}"
                                          Text="被动模式下地址为监听地址，留空为所有地址；主动模式下地址为主机地址。" />
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="计时器（毫秒）" IsCollapsible="True" IsCollapsed="True" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <WrapPanel>
                                <jv:TextBox Width="110" atc:TitleAssist.Title="T3 应答超时"
                                            Text="{Binding T3, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="T5 重连间隔"
                                            Text="{Binding T5, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="T6 控制事务"
                                            Text="{Binding T6, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="110" atc:TitleAssist.Title="T7 未选择超时"
                                            Text="{Binding T7, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="T8 字符间隔"
                                            Text="{Binding T8, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="140" atc:TitleAssist.Title="Linktest 间隔"
                                            Text="{Binding LinktestInterval, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="160" atc:TitleAssist.Title="最大报文长度（字节）"
                                            Text="{Binding MaxMessageLength, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <jv:TextBlock Style="{StaticResource Text.Hint}" Text="Linktest 间隔为 0 时不发送；最大报文长度至少 1024。" />
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="发送主消息">
                        <StackPanel>
                            <WrapPanel>
                                <jv:ComboBox Width="170" atc:TitleAssist.Title="常用模板" DisplayMemberPath="Name"
                                             ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" />
                                <jv:Button Content="填入" Command="{Binding ApplyTemplateCommand}" Margin="0,22,0,12" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="70" atc:TitleAssist.Title="S"
                                            Text="{Binding SendStream, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="90" atc:TitleAssist.Title="F（奇数）"
                                            Text="{Binding SendFunction, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:CheckBox Content="W 位（需要应答）" IsChecked="{Binding SendReplyExpected}" Margin="0,22,0,12" />
                            </WrapPanel>
                            <jv:TextBox Text="{Binding SendSml, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80"
                                        FontFamily="Consolas" TextWrapping="Wrap" atc:TitleAssist.Title="正文 SML（留空表示没有正文）" Margin="0,0,0,12" />
                            <jv:Button Content="发送" Command="{Binding SendCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                            <jv:TextBlock Text="{Binding SendMessage}" Style="{StaticResource Text.Hint}" />
                            <jv:TextBox Text="{Binding ReplySml, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="70"
                                        FontFamily="Consolas" TextWrapping="Wrap" atc:TitleAssist.Title="应答的 SML" />
                        </StackPanel>
                    </jv:GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Columns}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="260" MinHeight="120" />
                </Grid.RowDefinitions>

                <!-- 自动应答规则：左侧登记表单，右侧规则列表（会话状态与原因也在这里显示）。没有规则的 S/F 只在日志里显示头部（F-4）。 -->
                <jv:GroupBox Grid.Row="0" Header="自动应答规则" Margin="0">
                    <DockPanel>
                        <ScrollViewer DockPanel.Dock="Left" Width="330" Style="{StaticResource Panel.SettingsScroll}" Margin="0,0,12,0">
                            <StackPanel>
                                <jv:TextBlock Text="{Binding HsmsStateText, StringFormat=会话状态：{0}}" Style="{StaticResource Text.Section}" />
                                <jv:TextBlock Text="{Binding StateReason}" Style="{StaticResource Text.Hint}" />
                                <WrapPanel>
                                    <jv:TextBox Width="70" atc:TitleAssist.Title="S"
                                                Text="{Binding NewRuleStream, UpdateSourceTrigger=PropertyChanged}" />
                                    <jv:TextBox Width="90" atc:TitleAssist.Title="F（奇数）"
                                                Text="{Binding NewRuleFunction, UpdateSourceTrigger=PropertyChanged}" />
                                    <jv:ComboBox Width="130" atc:TitleAssist.Title="应答方式"
                                                 ItemsSource="{Binding Source={StaticResource RuleKindChoices}}" SelectedItem="{Binding NewRuleKind}" />
                                </WrapPanel>
                                <jv:TextBox Text="{Binding NewRuleSml, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="90"
                                            FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                            atc:TitleAssist.Title="应答的 SML（留空表示没有正文）" Margin="0,0,0,12" />
                                <WrapPanel>
                                    <jv:Button Content="登记（同一 S/F 替换）" Command="{Binding AddRuleCommand}" Margin="0,0,8,12" />
                                    <jv:Button Content="删除选中的规则" Command="{Binding RemoveRuleCommand}"
                                               CommandParameter="{Binding SelectedItem, ElementName=RuleGrid}" Margin="0,0,0,12" />
                                </WrapPanel>
                                <jv:TextBlock Text="{Binding RuleMessage}" Style="{StaticResource Text.Hint}" />
                            </StackPanel>
                        </ScrollViewer>
                        <DataGrid x:Name="RuleGrid" ItemsSource="{Binding Rules}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="S" Binding="{Binding Stream}" Width="50" />
                                <DataGridTextColumn Header="F" Binding="{Binding Function}" Width="50" />
                                <DataGridTextColumn Header="应答方式" Binding="{Binding KindText}" Width="110" />
                                <DataGridTextColumn Header="应答 SML" Binding="{Binding Sml}" Width="*" MinWidth="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </jv:GroupBox>

                <GridSplitter Grid.Row="1" Style="{StaticResource Splitter.Rows}" />

                <TabControl Grid.Row="2">
                    <TabItem Header="收到的主消息">
                        <DockPanel Margin="8">
                            <jv:TextBlock DockPanel.Dock="Top" Text="只显示有规则的 S/F 的正文，其它的只在日志中看到头部。" Style="{StaticResource Text.Hint}" />
                            <DataGrid ItemsSource="{Binding ReceivedMessages}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="90" />
                                    <DataGridTextColumn Header="S/F" Binding="{Binding Header}" Width="90" />
                                    <DataGridTextColumn Header="SML" Binding="{Binding Sml}" Width="*" MinWidth="200" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="操作记录">
                        <local:OperationListView Margin="8" />
                    </TabItem>
                    <TabItem Header="报文与日志">
                        <sessions:LogPanel DataContext="{Binding LogPanel}" Margin="8" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
