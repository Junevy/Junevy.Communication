<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Secs.SecsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:hsms="clr-namespace:Junevy.Communication.Secs.Hsms;assembly=Junevy.Communication.Secs"
             xmlns:secs="clr-namespace:Junevy.Communication.DebugAssistant.Protocols.Secs"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- SECS/HSMS 设备端页（计划第 7.6 节）：连接与计时器、自动应答规则、发送主消息与收到的主消息；公共面板。 -->
    <UserControl.Resources>
        <ObjectDataProvider x:Key="ModeChoices" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="hsms:HsmsConnectionMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="RuleKindChoices" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="secs:SecsRuleKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:ConnectionBarView Grid.Row="0" Margin="0,0,0,6" />

            <!-- 连接与计时器：运行中不可修改（库在启动时取快照） -->
            <jv:GroupBox Grid.Row="1" Header="连接与计时器（计时器单位为毫秒）" Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <StackPanel>
                    <WrapPanel>
                        <Label Content="模式" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource ModeChoices}}" SelectedItem="{Binding Mode}" Width="100" Margin="0,0,12,0" />
                        <Label Content="地址（被动为监听地址，留空为所有地址；主动为主机地址）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,12,0" />
                        <Label Content="端口" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                        <Label Content="设备号" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="T3 应答超时" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding T3, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="T5 重连间隔" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding T5, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="T6 控制事务" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding T6, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="T7 未选择超时" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding T7, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="T8 字符间隔" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding T8, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="Linktest 间隔（0 表示不发送）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding LinktestInterval, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="最大报文长度（字节，至少 1024）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MaxMessageLength, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                    </WrapPanel>
                </StackPanel>
            </jv:GroupBox>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：自动应答规则（会话状态与原因也在这里显示） -->
                <jv:GroupBox Grid.Column="0" Header="自动应答规则" Margin="0,0,6,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding HsmsStateText, StringFormat=会话状态：{0}}" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding StateReason}" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />
                        <WrapPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                            <Label Content="S" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding NewRuleStream, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,12,0" />
                            <Label Content="F（奇数）" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding NewRuleFunction, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,12,0" />
                            <ComboBox ItemsSource="{Binding Source={StaticResource RuleKindChoices}}" SelectedItem="{Binding NewRuleKind}" Width="110" Margin="0,0,12,0" />
                            <jv:Button Content="登记（同一 S/F 替换）" Command="{Binding AddRuleCommand}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="SML 应答的正文（留空表示没有正文）" Margin="0,6,0,0" />
                        <TextBox DockPanel.Dock="Top" Text="{Binding NewRuleSml, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" FontFamily="Consolas" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding RuleMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <jv:Button DockPanel.Dock="Bottom" Content="删除选中的规则" Command="{Binding RemoveRuleCommand}"
                                   CommandParameter="{Binding SelectedItem, ElementName=RuleGrid}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <DataGrid x:Name="RuleGrid" ItemsSource="{Binding Rules}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="S" Binding="{Binding Stream}" Width="50" />
                                <DataGridTextColumn Header="F" Binding="{Binding Function}" Width="50" />
                                <DataGridTextColumn Header="应答方式" Binding="{Binding KindText}" Width="110" />
                                <DataGridTextColumn Header="应答 SML" Binding="{Binding Sml}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </jv:GroupBox>

                <!-- 右：发送主消息与收到的主消息。没有规则的 S/F 只在日志里显示头部（F-4）。 -->
                <jv:GroupBox Grid.Column="1" Header="发送主消息" Margin="6,0,0,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <Label Content="常用模板" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Templates}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTemplate}" Width="180" Margin="0,0,6,0" />
                            <jv:Button Content="填入" Command="{Binding ApplyTemplateCommand}" />
                        </WrapPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                            <Label Content="S" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding SendStream, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,12,0" />
                            <Label Content="F（奇数）" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding SendFunction, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,12,0" />
                            <CheckBox Content="W 位（需要应答）" IsChecked="{Binding SendReplyExpected}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <jv:Button Content="发送" Command="{Binding SendCommand}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SendMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock DockPanel.Dock="Top" Text="正文 SML（留空表示没有正文）" Margin="0,4,0,0" />
                        <TextBox DockPanel.Dock="Top" Text="{Binding SendSml, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" FontFamily="Consolas" />
                        <TextBlock DockPanel.Dock="Top" Text="应答的 SML" Margin="0,4,0,0" />
                        <TextBox DockPanel.Dock="Top" Text="{Binding ReplySml, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="70" FontFamily="Consolas" />
                        <TextBlock DockPanel.Dock="Top" Text="收到的主消息（只显示有规则的 S/F 的正文，其它的只在日志中看到头部）" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <DataGrid ItemsSource="{Binding ReceivedMessages}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="90" />
                                <DataGridTextColumn Header="S/F" Binding="{Binding Header}" Width="90" />
                                <DataGridTextColumn Header="SML" Binding="{Binding Sml}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </jv:GroupBox>
            </Grid>

            <!-- 操作记录 -->
            <Border Grid.Row="3" Margin="0,6,0,0" Height="160">
                <local:OperationListView />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
