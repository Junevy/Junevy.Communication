<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Melsec.McPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:ports="clr-namespace:System.IO.Ports;assembly=System.IO.Ports"
             xmlns:plc="clr-namespace:Junevy.Communication.DebugAssistant.Protocols.Plc"
             xmlns:mc="clr-namespace:Junevy.Communication.Melsec;assembly=Junevy.Communication.Melsec"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:plcViews="clr-namespace:Junevy.Communication.DebugAssistant.Views.Plc"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- MC 页签（计划第 7.3 节）：帧类型、编码与传输的组合，和校验，访问路径，监视定时器与软元件速查表；公共面板。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ObjectDataProvider x:Key="Transports" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="plc:PlcTransport" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="EncodingChoices" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="mc:McEncoding" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ParityChoices" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:Parity" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="StopBitChoices" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:StopBits" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 传输、帧、编码，网络或串口参数，和校验 -->
            <jv:GroupBox Grid.Row="0" Header="传输、帧与编码" Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <StackPanel>
                    <WrapPanel>
                        <Label Content="传输" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource Transports}}" SelectedItem="{Binding Transport}" Width="100" Margin="0,0,12,0" />
                        <Label Content="帧类型" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="FrameBox" ItemsSource="{Binding AvailableFrames}" SelectedItem="{Binding Frame}" Width="100" Margin="0,0,12,0" />
                        <Label Content="编码" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource EncodingChoices}}" SelectedItem="{Binding Encoding}" Width="100" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding CombinationName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="主机" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,12,0" />
                        <Label Content="端口" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0" Visibility="{Binding IsSerial, Converter={StaticResource BoolToVisibility}}">
                        <Label Content="串口" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="波特率" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="数据位" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,12,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource ParityChoices}}" SelectedItem="{Binding Parity}" Width="90" Margin="0,0,12,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource StopBitChoices}}" SelectedItem="{Binding StopBits}" Width="90" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox x:Name="SumCheckBox" Content="和校验（只在串口时可编辑）" IsChecked="{Binding SumCheck}" IsEnabled="{Binding IsSerial}" />
                    </WrapPanel>
                    <TextBlock Text="TCP 与 UDP 只能选 3E 或 4E；串口只能选 4C（编码为 ASCII 时是格式 4，二进制时是格式 5）。切换传输时，帧类型改为该传输允许的第一个帧。"
                               TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" Margin="0,4,0,0" />
                </StackPanel>
            </jv:GroupBox>

            <local:ConnectionBarView Grid.Row="1" Margin="0,0,0,6" />

            <jv:GroupBox Grid.Row="2" Header="通道参数（超时、心跳、重连、套接字与 TLS）" IsCollapsible="True" IsCollapsed="True" Margin="0,0,0,6"
                         IsEnabled="{Binding IsEditable}">
                <local:ChannelSettingsView DataContext="{Binding Channel}" MaxHeight="360" />
            </jv:GroupBox>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- 左：公共面板 -->
                <plcViews:PlcPanelView Grid.Column="0" Margin="0,0,8,0" />

                <!-- 右：MC 特有的区域 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <jv:GroupBox Header="访问路径（十六进制，可带 0x）" Margin="0,0,0,8" IsEnabled="{Binding IsEditable}">
                            <StackPanel>
                                <WrapPanel>
                                    <Label Content="网络号" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding NetworkNumberHex, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0" />
                                    <Label Content="PC 号" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding PcNumberHex, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0" />
                                    <Label Content="模块 I/O 号" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding ModuleIoNumberHex, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <Label Content="模块站号" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding ModuleStationNumberHex, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0" />
                                    <StackPanel x:Name="SerialStationPanel" Orientation="Horizontal"
                                                Visibility="{Binding IsSerial, Converter={StaticResource BoolToVisibility}}">
                                        <Label Content="站号（4C）" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding StationNumberHex, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0" />
                                        <Label Content="本站号（4C）" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding SelfStationNumberHex, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="站号与本站号只属于 4C 帧，TCP 与 UDP 不发送它们。" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Theme.Brush.Text.Secondary}" Margin="0,4,0,0" />
                            </StackPanel>
                        </jv:GroupBox>

                        <jv:GroupBox Header="监视定时器（单位 250 毫秒，取值 1 到 65535）" Margin="0,0,0,8">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBox Text="{Binding MonitoringTimerUnits, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding MonitoringTimerText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </WrapPanel>
                                <!-- 有警告时才显示：浅黄底加深色文字（浅色主题的黄色本身对比度不足，不能直接作文字色） -->
                                <TextBlock Text="{Binding MonitoringTimerWarning}" TextWrapping="Wrap" Padding="6,3" Margin="0,4,0,0"
                                           Foreground="{DynamicResource Theme.Brush.Text.Primary}"
                                           Background="{DynamicResource Theme.Brush.Status.WarningSubtle}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MonitoringTimerWarning}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </jv:GroupBox>

                        <jv:GroupBox Header="软元件速查（十六进制软元件以粗体标出，点击“填入地址”）" Margin="0,0,0,8">
                            <!-- 28 行，不需要虚拟化。高亮只用粗体：触发器里的颜色取自动态资源，在测试宿主中会让 WPF 的绑定清理抛出 NullReferenceException。 -->
                            <DataGrid x:Name="DeviceGrid" ItemsSource="{Binding Devices}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                      MaxHeight="300" VirtualizingPanel.IsVirtualizing="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="软元件" Binding="{Binding Symbol}" Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Radix}" Value="16">
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60" />
                                    <DataGridTextColumn Header="进制" Binding="{Binding Radix}" Width="50" />
                                    <DataGridTextColumn Header="ASCII 代码" Binding="{Binding AsciiCode}" Width="80" />
                                    <DataGridTextColumn Header="二进制代码" Binding="{Binding BinaryCode}" Width="80" />
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <jv:Button Content="填入地址"
                                                           Command="{Binding DataContext.UseDeviceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </jv:GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 操作记录 -->
            <Border Grid.Row="4" Margin="0,6,0,0" Height="160">
                <local:OperationListView />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
