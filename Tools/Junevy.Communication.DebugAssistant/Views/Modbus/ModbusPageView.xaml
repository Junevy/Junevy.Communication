<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Modbus.ModbusPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:ports="clr-namespace:System.IO.Ports;assembly=System.IO.Ports"
             xmlns:plc="clr-namespace:Junevy.Communication.DebugAssistant.Protocols.Plc"
             xmlns:modbus="clr-namespace:Junevy.Communication.DebugAssistant.Protocols.Modbus"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:plcViews="clr-namespace:Junevy.Communication.DebugAssistant.Views.Plc"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- Modbus 页签（计划第 7.2 节）：左侧为传输、站号、通道参数与专用操作（掩码写、读写多个）；右侧上方为功能码提示与公共面板，下方为监控表、结果表格、操作记录与报文日志。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ObjectDataProvider x:Key="Transports" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="plc:PlcTransport" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="FrameChoices" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="modbus:ModbusFrameChoice" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ParityChoices" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:Parity" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="StopBitChoices" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:StopBits" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <local:ConnectionBarView DockPanel.Dock="Top" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Style="{StaticResource Panel.SettingsScroll}">
                <StackPanel>
                    <jv:GroupBox Header="传输与站号" IsEnabled="{Binding IsEditable}">
                        <StackPanel>
                            <WrapPanel>
                                <jv:ComboBox Width="120" atc:TitleAssist.Title="传输"
                                             ItemsSource="{Binding Source={StaticResource Transports}}" SelectedItem="{Binding Transport}" />
                                <jv:ComboBox Width="130" atc:TitleAssist.Title="帧格式"
                                             ItemsSource="{Binding Source={StaticResource FrameChoices}}" SelectedItem="{Binding Frame}" />
                            </WrapPanel>
                            <jv:TextBlock Style="{StaticResource Text.Section}" Text="{Binding CombinationName}" />
                            <!-- TCP 与 UDP 只显示主机与端口，串口只显示串口参数 -->
                            <WrapPanel x:Name="NetworkPanel">
                                <WrapPanel.Style>
                                    <Style TargetType="{x:Type WrapPanel}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSerial}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <jv:TextBox Width="200" atc:TitleAssist.Title="主机"
                                            Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="端口"
                                            Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="110" atc:TitleAssist.Title="默认站号"
                                            Text="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="150" atc:TitleAssist.Title="临时站号（留空不拼）"
                                            Text="{Binding TemporaryStation, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel x:Name="SerialPanel" Visibility="{Binding IsSerial, Converter={StaticResource BoolToVisibility}}">
                                <jv:TextBox Width="110" atc:TitleAssist.Title="串口"
                                            Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="100" atc:TitleAssist.Title="波特率"
                                            Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="90" atc:TitleAssist.Title="数据位"
                                            Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:ComboBox Width="100" atc:TitleAssist.Title="校验"
                                             ItemsSource="{Binding Source={StaticResource ParityChoices}}" SelectedItem="{Binding Parity}" />
                                <jv:ComboBox Width="100" atc:TitleAssist.Title="停止位"
                                             ItemsSource="{Binding Source={StaticResource StopBitChoices}}" SelectedItem="{Binding StopBits}" />
                            </WrapPanel>
                            <!-- 选项文字较长，换行显示，不被左侧列宽截断 -->
                            <jv:CheckBox IsChecked="{Binding UseSingleWriteFunctions}">
                                <TextBlock Text="写单个线圈或寄存器时用单个写入功能码（05、06）" TextWrapping="Wrap" />
                            </jv:CheckBox>
                            <jv:CheckBox Content="位写入用掩码写（0x16，原子）" IsChecked="{Binding UseMaskWriteForBits}" />
                            <jv:TextBlock Style="{StaticResource Text.Hint}"
                                          Text="串口只使用 RTU 帧；选择 MBAP 时会改为 RTU。UDP 为定向（主机与端口即对端）。" />
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="通道参数（超时、心跳、重连、TLS）" IsCollapsible="True" IsCollapsed="True"
                                 IsEnabled="{Binding IsEditable}">
                        <local:ChannelSettingsView DataContext="{Binding Channel}" />
                    </jv:GroupBox>

                    <jv:GroupBox Header="掩码写（0x16）" IsCollapsible="True" IsCollapsed="True">
                        <StackPanel>
                            <jv:TextBlock Style="{StaticResource Text.Hint}" Text="结果 = (当前 AND 与掩码) OR (或掩码 AND NOT 与掩码)" />
                            <WrapPanel>
                                <jv:TextBox Width="110" atc:TitleAssist.Title="与掩码"
                                            Text="{Binding MaskAndText, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="110" atc:TitleAssist.Title="或掩码"
                                            Text="{Binding MaskOrText, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="90" atc:TitleAssist.Title="位号（0 到 15）"
                                            Text="{Binding MaskBit, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:Button Content="置位" Command="{Binding SetMaskBitCommand}" Margin="0,22,8,12" />
                                <jv:Button Content="清零" Command="{Binding ClearMaskBitCommand}" Margin="0,22,8,12" />
                                <jv:Button Content="掩码写地址" Command="{Binding ApplyMaskCommand}" Margin="0,22,0,12" />
                            </WrapPanel>
                            <jv:TextBlock Style="{StaticResource Text.Hint}" Text="地址使用右侧公共面板的地址（需为保持寄存器 HR）。" />
                        </StackPanel>
                    </jv:GroupBox>

                    <jv:GroupBox Header="读写多个寄存器（0x17）" IsCollapsible="True" IsCollapsed="True">
                        <StackPanel>
                            <WrapPanel>
                                <jv:TextBox Width="110" atc:TitleAssist.Title="读地址"
                                            Text="{Binding ReadWriteReadAddress, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="100" atc:TitleAssist.Title="读数量"
                                            Text="{Binding ReadWriteReadCount, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <jv:TextBox Width="110" atc:TitleAssist.Title="写地址"
                                            Text="{Binding ReadWriteWriteAddress, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="160" atc:TitleAssist.Title="写数据"
                                            Text="{Binding ReadWriteWriteText, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <jv:Button Content="执行读写多个" Command="{Binding ReadWriteCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </jv:GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Columns}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="260" MinHeight="120" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Style="{StaticResource Panel.SettingsScroll}">
                    <StackPanel>
                        <jv:TextBlock Style="{StaticResource Text.Hint}" Text="{Binding FunctionHint}" />
                        <plcViews:PlcPanelView />
                    </StackPanel>
                </ScrollViewer>

                <GridSplitter Grid.Row="1" Style="{StaticResource Splitter.Rows}" />

                <TabControl Grid.Row="2">
                    <TabItem Header="监控表">
                        <plcViews:PlcMonitorView Margin="8" />
                    </TabItem>
                    <TabItem Header="结果表格">
                        <DockPanel Margin="8">
                            <WrapPanel DockPanel.Dock="Top">
                                <jv:TextBox Width="110" atc:TitleAssist.Title="地址"
                                            Text="{Binding TableAddress, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:TextBox Width="90" atc:TitleAssist.Title="数量"
                                            Text="{Binding TableCount, UpdateSourceTrigger=PropertyChanged}" />
                                <jv:Button Content="读取表格" Command="{Binding ReadTableCommand}" Margin="0,22,0,12" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Table}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="80" />
                                    <DataGridTextColumn Header="位" Binding="{Binding Bit}" Width="40" />
                                    <DataGridTextColumn Header="无符号" Binding="{Binding Unsigned}" Width="70" />
                                    <DataGridTextColumn Header="有符号" Binding="{Binding Signed}" Width="70" />
                                    <DataGridTextColumn Header="十六进制" Binding="{Binding Hex}" Width="70" />
                                    <DataGridTextColumn Header="二进制" Binding="{Binding Binary}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="操作记录">
                        <local:OperationListView Margin="8" />
                    </TabItem>
                    <TabItem Header="报文与日志">
                        <sessions:LogPanel DataContext="{Binding LogPanel}" Margin="8" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
