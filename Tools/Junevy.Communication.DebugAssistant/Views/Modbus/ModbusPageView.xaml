<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Modbus.ModbusPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:ports="clr-namespace:System.IO.Ports;assembly=System.IO.Ports"
             xmlns:plc="clr-namespace:Junevy.Communication.DebugAssistant.Protocols.Plc"
             xmlns:modbus="clr-namespace:Junevy.Communication.DebugAssistant.Protocols.Modbus"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:plcViews="clr-namespace:Junevy.Communication.DebugAssistant.Views.Plc"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- Modbus 页签（计划第 7.2 节）：传输与帧格式、站号、串口参数、Modbus 选项；公共面板；功能码提示、掩码写、读写多个寄存器与结果表格。 -->
    <UserControl.Resources>
        <ObjectDataProvider x:Key="Transports" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="plc:PlcTransport" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="FrameChoices" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="modbus:ModbusFrameChoice" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ParityChoices" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:Parity" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="StopBitChoices" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:StopBits" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 传输、帧格式与站号 -->
            <jv:GroupBox Grid.Row="0" Header="传输与站号" Margin="0,0,0,6" IsEnabled="{Binding IsEditable}">
                <StackPanel>
                    <WrapPanel>
                        <Label Content="传输" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource Transports}}" SelectedItem="{Binding Transport}" Width="100" Margin="0,0,12,0" />
                        <Label Content="帧格式" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource FrameChoices}}" SelectedItem="{Binding Frame}" Width="100" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding CombinationName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="主机" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,12,0" />
                        <Label Content="端口" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                        <Label Content="默认站号" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0" />
                        <Label Content="临时站号（留空不拼）" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding TemporaryStation, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Label Content="串口" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="波特率" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                        <Label Content="数据位" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,12,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource ParityChoices}}" SelectedItem="{Binding Parity}" Width="90" Margin="0,0,12,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource StopBitChoices}}" SelectedItem="{Binding StopBits}" Width="90" />
                    </WrapPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox Content="写单个线圈或寄存器时用单个写入功能码（05、06）" IsChecked="{Binding UseSingleWriteFunctions}" Margin="0,0,16,0" />
                        <CheckBox Content="位写入用掩码写（0x16，原子）" IsChecked="{Binding UseMaskWriteForBits}" />
                    </WrapPanel>
                    <TextBlock Text="串口只使用 RTU 帧；选择 MBAP 时会改为 RTU。UDP 为定向（主机与端口即对端）。" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" Margin="0,4,0,0" />
                </StackPanel>
            </jv:GroupBox>

            <local:ConnectionBarView Grid.Row="1" Margin="0,0,0,6" />

            <jv:GroupBox Grid.Row="2" Header="通道参数（超时、心跳、重连、套接字与 TLS）" IsCollapsible="True" IsCollapsed="True" Margin="0,0,0,6"
                         IsEnabled="{Binding IsEditable}">
                <local:ChannelSettingsView DataContext="{Binding Channel}" MaxHeight="360" />
            </jv:GroupBox>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- 左：公共面板 -->
                <plcViews:PlcPanelView Grid.Column="0" Margin="0,0,8,0" />

                <!-- 右：Modbus 特有的区域 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FunctionHint}" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" Margin="0,0,0,8" />

                        <jv:GroupBox Header="掩码写（0x16）：结果 = (当前 AND 与掩码) OR (或掩码 AND NOT 与掩码)" Margin="0,0,0,8">
                            <StackPanel>
                                <WrapPanel>
                                    <Label Content="与掩码" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding MaskAndText, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,12,0" />
                                    <Label Content="或掩码" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding MaskOrText, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <Label Content="位号 0 到 15" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding MaskBit, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,8,0" />
                                    <jv:Button Content="置位" Command="{Binding SetMaskBitCommand}" Margin="0,0,6,0" />
                                    <jv:Button Content="清零" Command="{Binding ClearMaskBitCommand}" Margin="0,0,12,0" />
                                    <jv:Button Content="掩码写地址" Command="{Binding ApplyMaskCommand}" />
                                </WrapPanel>
                                <TextBlock Text="地址使用上方公共面板的地址（需为保持寄存器 HR）。" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" Margin="0,4,0,0" />
                            </StackPanel>
                        </jv:GroupBox>

                        <jv:GroupBox Header="读写多个寄存器（0x17）" Margin="0,0,0,8">
                            <StackPanel>
                                <WrapPanel>
                                    <Label Content="读地址" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding ReadWriteReadAddress, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,8,0" />
                                    <Label Content="读数量" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding ReadWriteReadCount, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <Label Content="写地址" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding ReadWriteWriteAddress, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,8,0" />
                                    <Label Content="写数据" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding ReadWriteWriteText, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                </WrapPanel>
                                <jv:Button Content="执行读写多个" Command="{Binding ReadWriteCommand}" Margin="0,4,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </jv:GroupBox>

                        <jv:GroupBox Header="结果表格" Margin="0,0,0,8">
                            <StackPanel>
                                <WrapPanel>
                                    <Label Content="地址" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding TableAddress, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,8,0" />
                                    <Label Content="数量" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding TableCount, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,8,0" />
                                    <jv:Button Content="读取表格" Command="{Binding ReadTableCommand}" />
                                </WrapPanel>
                                <DataGrid ItemsSource="{Binding Table}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                          MaxHeight="260" Margin="0,4,0,0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="80" />
                                        <DataGridTextColumn Header="位" Binding="{Binding Bit}" Width="40" />
                                        <DataGridTextColumn Header="无符号" Binding="{Binding Unsigned}" Width="70" />
                                        <DataGridTextColumn Header="有符号" Binding="{Binding Signed}" Width="70" />
                                        <DataGridTextColumn Header="十六进制" Binding="{Binding Hex}" Width="70" />
                                        <DataGridTextColumn Header="二进制" Binding="{Binding Binary}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </jv:GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 操作记录 -->
            <Border Grid.Row="4" Margin="0,6,0,0" Height="160">
                <local:OperationListView />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
