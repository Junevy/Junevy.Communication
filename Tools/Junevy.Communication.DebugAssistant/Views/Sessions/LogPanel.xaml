<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Sessions.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:shared="clr-namespace:Junevy.Communication.DebugAssistant.Views.Shared">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 列不在视觉树中，显隐通过代理绑定到面板的视图模型 -->
        <shared:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </UserControl.Resources>
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" VerticalAlignment="Center">
            <jv:ToggleButton Content="暂停" IsChecked="{Binding IsPaused}" Margin="0,0,8,8" />
            <jv:Button Content="清空" Command="{Binding ClearCommand}" Margin="0,0,8,8" />
            <jv:Button Content="导出" Command="{Binding ExportCommand}" Margin="0,0,24,8" />
            <jv:CheckBox Content="报文" IsChecked="{Binding ShowFrames}" Margin="0,0,16,8" />
            <jv:CheckBox Content="日志" IsChecked="{Binding ShowLogs}" Margin="0,0,16,8" />
            <jv:ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding MinimumLevel}" Width="120" Margin="0,0,24,8" />
            <jv:CheckBox Content="HEX" IsChecked="{Binding ShowHex}" Margin="0,0,16,8" />
            <jv:CheckBox Content="ASCII" IsChecked="{Binding ShowAscii}" Margin="0,0,16,8" />
            <jv:CheckBox Content="时间戳" IsChecked="{Binding ShowTimestamps}" Margin="0,0,16,8" />
        </WrapPanel>

        <jv:TextBlock DockPanel.Dock="Top" Text="{Binding StatisticsText}" Style="{StaticResource Text.Hint}" Margin="0,0,0,8" />

        <DataGrid x:Name="EntryGrid" ItemsSource="{Binding Entries}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss.fff}" Width="100"
                                    Visibility="{Binding Data.ShowTimestamps, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}" />
                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="60" />
                <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*" MinWidth="160" />
                <DataGridTextColumn Header="HEX" Binding="{Binding HexColumn}" Width="2*" MinWidth="200"
                                    Visibility="{Binding Data.ShowHex, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}" />
                <DataGridTextColumn Header="ASCII" Binding="{Binding AsciiColumn}" Width="*" MinWidth="120"
                                    Visibility="{Binding Data.ShowAscii, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibility}}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
