<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Sessions.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <jv:ToggleButton Content="暂停" IsChecked="{Binding IsPaused}" Margin="0,0,8,0" />
            <jv:Button Content="清空" Command="{Binding ClearCommand}" Margin="0,0,8,0" />
            <jv:Button Content="导出" Command="{Binding ExportCommand}" Margin="0,0,16,0" />
            <CheckBox Content="报文" IsChecked="{Binding ShowFrames}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <CheckBox Content="日志" IsChecked="{Binding ShowLogs}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding MinimumLevel}" Width="120" Margin="0,0,16,0" />
            <CheckBox Content="HEX" IsChecked="{Binding ShowHex}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <CheckBox Content="ASCII" IsChecked="{Binding ShowAscii}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <CheckBox Content="时间戳" IsChecked="{Binding ShowTimestamps}" VerticalAlignment="Center" />
        </WrapPanel>

        <jv:TextBlock DockPanel.Dock="Top" Text="{Binding StatisticsText}" Margin="0,0,0,6"
                      Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />

        <DataGrid ItemsSource="{Binding Entries}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss.fff}" Width="100"
                                    Visibility="{Binding ShowTimestamps, Converter={StaticResource BoolToVisibility}}" />
                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="60" />
                <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*" />
                <DataGridTextColumn Header="HEX" Binding="{Binding HexColumn}" Width="2*"
                                    Visibility="{Binding ShowHex, Converter={StaticResource BoolToVisibility}}" />
                <DataGridTextColumn Header="ASCII" Binding="{Binding AsciiColumn}" Width="*"
                                    Visibility="{Binding ShowAscii, Converter={StaticResource BoolToVisibility}}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
