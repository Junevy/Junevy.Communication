<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Simulators.SimulatorPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:mc="clr-namespace:Junevy.Communication.DebugAssistant.Simulators.Melsec;assembly=Junevy.Communication.DebugAssistant.Simulators"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- 模拟设备页签（计划第 7.14 节）：宿主参数、设备参数、内存表、故障注入、请求日志。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ObjectDataProvider x:Key="McFrames" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="mc:McFrameKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="McEncodings" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="mc:McEncodingKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <DockPanel Margin="8">
        <sessions:LogPanel DockPanel.Dock="Bottom" DataContext="{Binding LogPanel}" Height="220" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:ConnectionBarView Grid.Row="0" Margin="0,0,0,6" />

            <TabControl Grid.Row="1">
                <!-- 宿主参数：传输、地址与串口 -->
                <TabItem Header="宿主参数">
                    <StackPanel Margin="8">
                        <WrapPanel IsEnabled="{Binding IsEditable}">
                            <Label Content="传输" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding TransportChoices}" SelectedItem="{Binding Transport}" Width="100" Margin="0,0,12,0" />
                            <Label Content="组合" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CombinationText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0" IsEnabled="{Binding IsEditable}">
                            <Label Content="监听地址" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,12,0" />
                            <Label Content="端口" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0" IsEnabled="{Binding IsEditable}"
                                   Visibility="{Binding IsSerialTransport, Converter={StaticResource BoolToVisibility}}">
                            <Label Content="串口" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                            <Label Content="波特率" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                        </WrapPanel>
                        <TextBlock Text="宿主参数在启动时生效。" Margin="0,8,0,0" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />
                    </StackPanel>
                </TabItem>

                <!-- 设备参数：按设备种类显示 -->
                <TabItem Header="设备参数">
                    <StackPanel Margin="8">
                        <WrapPanel IsEnabled="{Binding IsEditable}" Visibility="{Binding IsModbusDevice, Converter={StaticResource BoolToVisibility}}">
                            <Label Content="应答的站号（逗号分隔）" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding UnitIds, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,12,0" />
                            <CheckBox Content="RTU 帧（默认 MBAP；串口总是 RTU）" IsChecked="{Binding ModbusRtu}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <WrapPanel IsEnabled="{Binding IsEditable}" Visibility="{Binding IsMcDevice, Converter={StaticResource BoolToVisibility}}">
                            <Label Content="帧" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Source={StaticResource McFrames}}" SelectedItem="{Binding McFrame}" Width="100" Margin="0,0,12,0" />
                            <Label Content="编码" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Source={StaticResource McEncodings}}" SelectedItem="{Binding McEncoding}" Width="100" Margin="0,0,12,0" />
                            <CheckBox Content="和校验（4C）" IsChecked="{Binding McSumCheck}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <WrapPanel IsEnabled="{Binding IsEditable}" Visibility="{Binding IsS7Device, Converter={StaticResource BoolToVisibility}}">
                            <Label Content="PDU 长度（240、480 或 960）" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding S7Pdu, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                            <CheckBox Content="PUT/GET 开放" IsChecked="{Binding S7PutGet}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <!-- 数据块不属于协议参数，运行中也可以新建；客户端访问 DB 时才查找它。 -->
                        <WrapPanel x:Name="DataBlockPanel" Margin="0,8,0,0" Visibility="{Binding IsS7Device, Converter={StaticResource BoolToVisibility}}">
                            <Label Content="新建数据块：编号" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding NewDataBlockNumber, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0" />
                            <Label Content="大小（字节）" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding NewDataBlockSize, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                            <jv:Button Content="创建" Command="{Binding AddDataBlockCommand}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding DataBlockMessage}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <WrapPanel IsEnabled="{Binding IsEditable}" Visibility="{Binding IsFinsDevice, Converter={StaticResource BoolToVisibility}}">
                            <Label Content="服务器节点" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding FinsServerNode, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0" />
                            <Label Content="分配给客户端的节点" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding FinsClientNode, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                        </WrapPanel>
                        <TextBlock Text="设备参数在启动时生效。" Margin="0,8,0,0" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />
                    </StackPanel>
                </TabItem>

                <!-- 内存表：字区按字显示并可编辑；位区与字节区每行 16 个，只读 -->
                <TabItem Header="内存表">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top">
                            <WrapPanel>
                                <Label Content="存储区" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding MemoryAreas}" SelectedItem="{Binding SelectedArea}" Width="120" Margin="0,0,12,0" />
                                <jv:Button Content="上一页" Command="{Binding PreviousPageCommand}" Margin="0,0,6,0" />
                                <jv:Button Content="下一页" Command="{Binding NextPageCommand}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding MemoryPageText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <CheckBox Content="自增（每 0.5 秒加 1）" IsChecked="{Binding AutoIncrement}" IsEnabled="{Binding IsWordArea}" VerticalAlignment="Center" />
                            </WrapPanel>
                            <WrapPanel x:Name="EditPanel" Margin="0,6,0,6" IsEnabled="{Binding IsWordArea}">
                                <Label Content="地址" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,0" />
                                <Label Content="值（十进制或 0x）" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,12,0" />
                                <jv:Button Content="写入字" Command="{Binding WriteWordCommand}" />
                                <TextBlock Text="{Binding MemoryMessage}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="位区与字节区只读。" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Theme.Brush.Text.Secondary}" />
                            </WrapPanel>
                        </StackPanel>
                        <Grid>
                            <DataGrid x:Name="WordGrid" ItemsSource="{Binding WordRows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                      Visibility="{Binding IsWordArea, Converter={StaticResource BoolToVisibility}}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="80" />
                                    <DataGridTextColumn Header="无符号" Binding="{Binding Unsigned}" Width="90" />
                                    <DataGridTextColumn Header="有符号" Binding="{Binding Signed}" Width="90" />
                                    <DataGridTextColumn Header="十六进制" Binding="{Binding Hex}" Width="90" />
                                    <DataGridTextColumn Header="二进制" Binding="{Binding Binary}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid x:Name="BitGrid" ItemsSource="{Binding BitRows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                      FontFamily="Consolas" Visibility="{Binding IsBitArea, Converter={StaticResource BoolToVisibility}}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="80" />
                                    <DataGridTextColumn Header="位（每行 16 个，地址从左到右递增）" Binding="{Binding Bits}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid x:Name="ByteGrid" ItemsSource="{Binding ByteRows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                      FontFamily="Consolas" Visibility="{Binding IsByteArea, Converter={StaticResource BoolToVisibility}}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="80" />
                                    <DataGridTextColumn Header="字节（每行 16 个，十六进制）" Binding="{Binding Bytes}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <!-- 故障注入 -->
                <TabItem Header="故障注入">
                    <StackPanel Margin="8">
                        <WrapPanel>
                            <Label Content="应答延迟（毫秒，0 到 60000）" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding FaultDelayMilliseconds, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        </WrapPanel>
                        <CheckBox Content="不应答" IsChecked="{Binding FaultNoReply}" Margin="0,8,0,0" />
                        <WrapPanel Margin="0,8,0,0">
                            <Label Content="强制错误码（留空不强制）" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding FaultForcedErrorText, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                        </WrapPanel>
                        <CheckBox Content="破坏校验（RTU 的 CRC、4C 的和校验）" IsChecked="{Binding FaultCorruptChecksum}" Margin="0,8,0,0" />
                        <CheckBox Content="收到下一个请求后断开连接（一次性）" IsChecked="{Binding FaultDisconnectNext}" Margin="0,8,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <jv:Button Content="应用" Command="{Binding ApplyFaultsCommand}" Margin="0,0,6,0" />
                            <jv:Button Content="清除" Command="{Binding ClearFaultsCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding FaultMessage}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </TabItem>

                <!-- 请求日志：每个请求的摘要与十六进制 -->
                <TabItem Header="请求日志">
                    <DataGrid ItemsSource="{Binding Requests}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              Margin="8" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="90" />
                            <DataGridTextColumn Header="对端" Binding="{Binding Remote}" Width="130" />
                            <DataGridTextColumn Header="结论" Binding="{Binding Kind}" Width="70" />
                            <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="220" />
                            <DataGridTextColumn Header="请求" Binding="{Binding Request}" Width="*" />
                            <DataGridTextColumn Header="应答" Binding="{Binding Response}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <!-- 操作记录 -->
            <Border Grid.Row="2" Margin="0,6,0,0" Height="160">
                <local:OperationListView />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
