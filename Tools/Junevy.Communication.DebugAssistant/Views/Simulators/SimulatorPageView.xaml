<UserControl x:Class="Junevy.Communication.DebugAssistant.Views.Simulators.SimulatorPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jv="github.com.junevy"
             xmlns:atc="clr-namespace:Junevy.Controls.AttachedProperties;assembly=Junevy.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:mc="clr-namespace:Junevy.Communication.DebugAssistant.Simulators.Melsec;assembly=Junevy.Communication.DebugAssistant.Simulators"
             xmlns:local="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
             xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions">
    <!-- 模拟设备页签（计划第 7.14 节）：顶部连接栏；中间按标签页分组（宿主参数、设备参数、内存表、故障注入、请求日志）；底部为操作记录与报文日志。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ObjectDataProvider x:Key="McFrames" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="mc:McFrameKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="McEncodings" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="mc:McEncodingKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <jv:ExpanderPanel DockPanel.Dock="Bottom" DisplayMode="Card" Header="报文与日志" IsExpanded="False" Margin="0,12,0,0">
            <sessions:LogPanel DataContext="{Binding LogPanel}" Height="200" />
        </jv:ExpanderPanel>

        <local:ConnectionBarView DockPanel.Dock="Top" />

        <local:OperationListView DockPanel.Dock="Bottom" Height="130" Margin="0,12,0,0" />

        <jv:TabControl>
            <!-- 宿主参数：传输、地址与串口 -->
            <jv:TabControlItem CanClose="False" Header="宿主参数">
                <StackPanel Margin="12">
                    <WrapPanel IsEnabled="{Binding IsEditable}">
                        <jv:ComboBox Width="130" atc:TitleAssist.Title="传输"
                                     ItemsSource="{Binding TransportChoices}" SelectedItem="{Binding Transport}" />
                        <jv:TextBlock Text="{Binding CombinationText}" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                    </WrapPanel>
                    <WrapPanel IsEnabled="{Binding IsEditable}">
                        <jv:TextBox Width="200" atc:TitleAssist.Title="监听地址"
                                    Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                        <jv:TextBox Width="110" atc:TitleAssist.Title="端口"
                                    Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                    <WrapPanel IsEnabled="{Binding IsEditable}"
                               Visibility="{Binding IsSerialTransport, Converter={StaticResource BoolToVisibility}}">
                        <jv:TextBox Width="130" atc:TitleAssist.Title="串口"
                                    Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" />
                        <jv:TextBox Width="110" atc:TitleAssist.Title="波特率"
                                    Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                    <jv:TextBlock Text="宿主参数在启动时生效。" Style="{StaticResource Text.Hint}" />
                </StackPanel>
            </jv:TabControlItem>

            <!-- 设备参数：按设备种类显示 -->
            <jv:TabControlItem CanClose="False" Header="设备参数">
                <StackPanel Margin="12">
                    <WrapPanel IsEnabled="{Binding IsEditable}" Visibility="{Binding IsModbusDevice, Converter={StaticResource BoolToVisibility}}">
                        <jv:TextBox Width="170" atc:TitleAssist.Title="应答的站号（逗号分隔）"
                                    Text="{Binding UnitIds, UpdateSourceTrigger=PropertyChanged}" />
                        <jv:CheckBox Content="RTU 帧（默认 MBAP；串口总是 RTU）" IsChecked="{Binding ModbusRtu}" Margin="0,22,0,12" />
                    </WrapPanel>
                    <WrapPanel IsEnabled="{Binding IsEditable}" Visibility="{Binding IsMcDevice, Converter={StaticResource BoolToVisibility}}">
                        <jv:ComboBox Width="110" atc:TitleAssist.Title="帧"
                                     ItemsSource="{Binding Source={StaticResource McFrames}}" SelectedItem="{Binding McFrame}" />
                        <jv:ComboBox Width="110" atc:TitleAssist.Title="编码"
                                     ItemsSource="{Binding Source={StaticResource McEncodings}}" SelectedItem="{Binding McEncoding}" />
                        <jv:CheckBox Content="和校验（4C）" IsChecked="{Binding McSumCheck}" Margin="0,22,0,12" />
                    </WrapPanel>
                    <WrapPanel IsEnabled="{Binding IsEditable}" Visibility="{Binding IsS7Device, Converter={StaticResource BoolToVisibility}}">
                        <jv:TextBox Width="200" atc:TitleAssist.Title="PDU 长度（240、480 或 960）"
                                    Text="{Binding S7Pdu, UpdateSourceTrigger=PropertyChanged}" />
                        <jv:CheckBox Content="PUT/GET 开放" IsChecked="{Binding S7PutGet}" Margin="0,22,0,12" />
                    </WrapPanel>
                    <!-- 数据块不属于协议参数，运行中也可以新建；客户端访问 DB 时才查找它。 -->
                    <WrapPanel x:Name="DataBlockPanel" Visibility="{Binding IsS7Device, Converter={StaticResource BoolToVisibility}}">
                        <jv:TextBox Width="110" atc:TitleAssist.Title="新建数据块：编号"
                                    Text="{Binding NewDataBlockNumber, UpdateSourceTrigger=PropertyChanged}" />
                        <jv:TextBox Width="130" atc:TitleAssist.Title="大小（字节）"
                                    Text="{Binding NewDataBlockSize, UpdateSourceTrigger=PropertyChanged}" />
                        <jv:Button Content="创建" Command="{Binding AddDataBlockCommand}" Margin="0,22,8,12" />
                        <jv:TextBlock Text="{Binding DataBlockMessage}" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                    </WrapPanel>
                    <WrapPanel IsEnabled="{Binding IsEditable}" Visibility="{Binding IsFinsDevice, Converter={StaticResource BoolToVisibility}}">
                        <jv:TextBox Width="130" atc:TitleAssist.Title="服务器节点"
                                    Text="{Binding FinsServerNode, UpdateSourceTrigger=PropertyChanged}" />
                        <jv:TextBox Width="170" atc:TitleAssist.Title="分配给客户端的节点"
                                    Text="{Binding FinsClientNode, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                    <jv:TextBlock Text="设备参数在启动时生效。" Style="{StaticResource Text.Hint}" />
                </StackPanel>
            </jv:TabControlItem>

            <!-- 内存表：字区按字显示并可编辑；位区与字节区每行 16 个，只读 -->
            <jv:TabControlItem CanClose="False" Header="内存表">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel>
                            <jv:ComboBox Width="130" atc:TitleAssist.Title="存储区"
                                         ItemsSource="{Binding MemoryAreas}" SelectedItem="{Binding SelectedArea}" />
                            <jv:Button Content="上一页" Command="{Binding PreviousPageCommand}" Margin="0,22,8,12" />
                            <jv:Button Content="下一页" Command="{Binding NextPageCommand}" Margin="0,22,12,12" />
                            <jv:TextBlock Text="{Binding MemoryPageText}" VerticalAlignment="Bottom" Margin="0,0,16,12" />
                            <jv:CheckBox Content="自增（每 0.5 秒加 1）" IsChecked="{Binding AutoIncrement}" IsEnabled="{Binding IsWordArea}" Margin="0,22,0,12" />
                        </WrapPanel>
                        <WrapPanel x:Name="EditPanel" IsEnabled="{Binding IsWordArea}">
                            <jv:TextBox Width="110" atc:TitleAssist.Title="地址"
                                        Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" />
                            <jv:TextBox Width="150" atc:TitleAssist.Title="值（十进制或 0x）"
                                        Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" />
                            <jv:Button Content="写入字" Command="{Binding WriteWordCommand}" Margin="0,22,12,12" />
                            <jv:TextBlock Text="位区与字节区只读。" Style="{StaticResource Text.Hint}" Margin="0,22,0,12" />
                        </WrapPanel>
                        <jv:TextBlock Text="{Binding MemoryMessage}" Style="{StaticResource Text.Hint}" />
                    </StackPanel>
                    <Grid>
                        <DataGrid x:Name="WordGrid" ItemsSource="{Binding WordRows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  Visibility="{Binding IsWordArea, Converter={StaticResource BoolToVisibility}}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="80" />
                                <DataGridTextColumn Header="无符号" Binding="{Binding Unsigned}" Width="90" />
                                <DataGridTextColumn Header="有符号" Binding="{Binding Signed}" Width="90" />
                                <DataGridTextColumn Header="十六进制" Binding="{Binding Hex}" Width="90" />
                                <DataGridTextColumn Header="二进制" Binding="{Binding Binary}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid x:Name="BitGrid" ItemsSource="{Binding BitRows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  FontFamily="Consolas" Visibility="{Binding IsBitArea, Converter={StaticResource BoolToVisibility}}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="80" />
                                <DataGridTextColumn Header="位（每行 16 个，地址从左到右递增）" Binding="{Binding Bits}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid x:Name="ByteGrid" ItemsSource="{Binding ByteRows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  FontFamily="Consolas" Visibility="{Binding IsByteArea, Converter={StaticResource BoolToVisibility}}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="80" />
                                <DataGridTextColumn Header="字节（每行 16 个，十六进制）" Binding="{Binding Bytes}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </jv:TabControlItem>

            <!-- 故障注入 -->
            <jv:TabControlItem CanClose="False" Header="故障注入">
                <StackPanel Margin="12">
                    <WrapPanel>
                        <jv:TextBox Width="200" atc:TitleAssist.Title="应答延迟（毫秒，0 到 60000）"
                                    Text="{Binding FaultDelayMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                        <jv:TextBox Width="160" atc:TitleAssist.Title="强制错误码（留空不强制）"
                                    Text="{Binding FaultForcedErrorText, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                    <jv:CheckBox Content="不应答" IsChecked="{Binding FaultNoReply}" />
                    <jv:CheckBox Content="破坏校验（RTU 的 CRC、4C 的和校验）" IsChecked="{Binding FaultCorruptChecksum}" />
                    <jv:CheckBox Content="收到下一个请求后断开连接（一次性）" IsChecked="{Binding FaultDisconnectNext}" />
                    <WrapPanel Margin="0,8,0,0">
                        <jv:Button Content="应用" Command="{Binding ApplyFaultsCommand}" Margin="0,0,8,12" />
                        <jv:Button Content="清除" Command="{Binding ClearFaultsCommand}" Margin="0,0,8,12" />
                    </WrapPanel>
                    <jv:TextBlock Text="{Binding FaultMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </jv:TabControlItem>

            <!-- 请求日志：每个请求的摘要与十六进制 -->
            <jv:TabControlItem CanClose="False" Header="请求日志">
                <DataGrid ItemsSource="{Binding Requests}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                          Margin="12" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="90" />
                        <DataGridTextColumn Header="对端" Binding="{Binding Remote}" Width="130" />
                        <DataGridTextColumn Header="结论" Binding="{Binding Kind}" Width="70" />
                        <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="220" />
                        <DataGridTextColumn Header="请求" Binding="{Binding Request}" Width="*" />
                        <DataGridTextColumn Header="应答" Binding="{Binding Response}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </jv:TabControlItem>
        </jv:TabControl>
    </DockPanel>
</UserControl>
