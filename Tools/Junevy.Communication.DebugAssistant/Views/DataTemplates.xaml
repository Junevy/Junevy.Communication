<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sessions="clr-namespace:Junevy.Communication.DebugAssistant.Sessions"
                    xmlns:views="clr-namespace:Junevy.Communication.DebugAssistant.Views.Sessions"
                    xmlns:channels="clr-namespace:Junevy.Communication.DebugAssistant.Protocols.Channels"
                    xmlns:channelViews="clr-namespace:Junevy.Communication.DebugAssistant.Views.Channels"
                    xmlns:modbus="clr-namespace:Junevy.Communication.DebugAssistant.Protocols.Modbus"
                    xmlns:modbusViews="clr-namespace:Junevy.Communication.DebugAssistant.Views.Modbus"
                    xmlns:melsec="clr-namespace:Junevy.Communication.DebugAssistant.Protocols.Melsec"
                    xmlns:melsecViews="clr-namespace:Junevy.Communication.DebugAssistant.Views.Melsec">

    <!-- 页签内容：按视图模型类型选择视图（计划第 5.2 节）。每种页签完成后在这里加一条。 -->
    <DataTemplate DataType="{x:Type sessions:PlaceholderSessionViewModel}">
        <views:PlaceholderSessionView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type channels:TcpClientSessionViewModel}">
        <channelViews:TcpClientPageView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type channels:UdpSessionViewModel}">
        <channelViews:UdpPageView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type channels:SerialSessionViewModel}">
        <channelViews:SerialPageView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type modbus:ModbusSessionViewModel}">
        <modbusViews:ModbusPageView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type melsec:McSessionViewModel}">
        <melsecViews:McPageView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type channels:TcpServerSessionViewModel}">
        <channelViews:TcpServerPageView />
    </DataTemplate>

</ResourceDictionary>
